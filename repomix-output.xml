<file path="SQLPulseUI/src/components/query-history/BaselineCard.tsx">
import {
  Paper,
  Typography,
  Box,
  Alert,
  Tooltip,
} from '@mui/material';
import InfoOutlinedIcon from '@mui/icons-material/InfoOutlined';
import { formatFloat } from '../../utils/formatters';
import type { QueryBaselineResponse, BaselineStatistic } from '../../types/history';

interface Props {
  baseline: QueryBaselineResponse;
}

const METRIC_LABELS: Record<string, string> = {
  avg_elapsed_ms: 'Avg Duration (ms)',
  avg_cpu_ms: 'Avg CPU (ms)',
  avg_logical_reads: 'Avg Logical Reads',
  avg_physical_reads: 'Avg Physical Reads',
  execution_count: 'Execution Count',
};

const STAT_TOOLTIPS: Record<string, string> = {
  Mean: 'Average value across all samples',
  Median: 'Typical middle value — half of observations are above, half below',
  P50: '50th percentile — same as median',
  P95: '95% of observations were at or below this value',
  'Std Dev': 'How much performance normally varies from the mean',
};

function StatLabel({ label }: { label: string }) {
  const tip = STAT_TOOLTIPS[label];
  return (
    <Box sx={{ display: 'inline-flex', alignItems: 'center', gap: 0.5 }}>
      <Typography variant="caption" color="text.secondary" fontWeight={600}>
        {label}
      </Typography>
      {tip && (
        <Tooltip title={tip} arrow placement="top">
          <InfoOutlinedIcon sx={{ fontSize: 14, color: 'text.disabled', cursor: 'help' }} />
        </Tooltip>
      )}
    </Box>
  );
}

function StatRow({ stat }: { stat: BaselineStatistic }) {
  const items: { label: string; value: string }[] = [
    { label: 'Samples', value: stat.sample_count.toLocaleString() },
    { label: 'Mean', value: formatFloat(stat.mean, 2) },
    { label: 'Median', value: formatFloat(stat.median, 2) },
    { label: 'P50', value: formatFloat(stat.p50, 2) },
    { label: 'P95', value: formatFloat(stat.p95, 2) },
    { label: 'Std Dev', value: formatFloat(stat.standard_deviation, 2) },
    { label: 'Min', value: formatFloat(stat.minimum, 2) },
    { label: 'Max', value: formatFloat(stat.maximum, 2) },
  ];

  return (
    <Box sx={{ display: 'flex', flexWrap: 'wrap', gap: 3 }}>
      {items.map((it) => (
        <Box key={it.label} sx={{ minWidth: 80 }}>
          <StatLabel label={it.label} />
          <Typography variant="body2" fontWeight={500}>
            {it.value}
          </Typography>
        </Box>
      ))}
    </Box>
  );
}

export default function BaselineCard({ baseline }: Props) {
  if (baseline.baseline_status === 'INSUFFICIENT_DATA') {
    return (
      <Paper variant="outlined" sx={{ p: 2 }}>
        <Typography variant="subtitle1" fontWeight={600} gutterBottom>
          Baseline — {baseline.window} window
        </Typography>
        <Alert severity="info" variant="outlined">
          SQLPulse does not yet have enough historical samples to establish a reliable baseline.
        </Alert>
      </Paper>
    );
  }

  const metricEntries = Object.entries(baseline.metrics);

  return (
    <Paper variant="outlined" sx={{ p: 2 }}>
      <Typography variant="subtitle1" fontWeight={600} gutterBottom>
        Baseline — {baseline.window} window
        <Typography component="span" variant="body2" color="text.secondary" sx={{ ml: 1 }}>
          ({baseline.sample_count} total samples)
        </Typography>
      </Typography>

      {metricEntries.length === 0 && (
        <Typography variant="body2" color="text.secondary">
          No baseline metrics available.
        </Typography>
      )}

      {metricEntries.map(([key, stat]) => (
        <Box key={key} sx={{ mb: 2 }}>
          <Typography variant="body2" fontWeight={600} sx={{ mb: 0.5 }}>
            {METRIC_LABELS[key] ?? key}
          </Typography>
          <StatRow stat={stat} />
        </Box>
      ))}
    </Paper>
  );
}
</file>

<file path="SQLPulseUI/src/components/query-history/QueryHistoryCharts.tsx">
import { useState } from 'react';
import { Box, Tabs, Tab, Paper, Typography } from '@mui/material';
import {
  ResponsiveContainer,
  LineChart,
  Line,
  XAxis,
  YAxis,
  CartesianGrid,
  Tooltip,
} from 'recharts';
import { formatTimestamp, formatTimestampShort } from '../../utils/formatters';
import type { QueryMetricRecord } from '../../types/history';

interface Props {
  samples: QueryMetricRecord[];
}

interface ChartDef {
  label: string;
  dataKey: keyof QueryMetricRecord;
  color: string;
  unit: string;
}

const CHARTS: ChartDef[] = [
  { label: 'Duration', dataKey: 'avg_elapsed_time_ms', color: '#1976d2', unit: 'ms' },
  { label: 'CPU', dataKey: 'avg_cpu_time_ms', color: '#ed6c02', unit: 'ms' },
  { label: 'Logical Reads', dataKey: 'avg_logical_reads', color: '#2e7d32', unit: '' },
];

export default function QueryHistoryCharts({ samples }: Props) {
  const [tab, setTab] = useState(0);

  if (samples.length === 0) {
    return (
      <Paper variant="outlined" sx={{ p: 3, textAlign: 'center' }}>
        <Typography color="text.secondary">No historical samples to chart.</Typography>
      </Paper>
    );
  }

  const sorted = [...samples].sort(
    (a, b) => new Date(a.collected_at).getTime() - new Date(b.collected_at).getTime(),
  );

  const chart = CHARTS[tab]!;

  return (
    <Paper variant="outlined" sx={{ p: 2 }}>
      <Tabs value={tab} onChange={(_, v) => setTab(v)} sx={{ mb: 2 }}>
        {CHARTS.map((c) => (
          <Tab key={c.label} label={c.label} />
        ))}
      </Tabs>

      <Box sx={{ width: '100%', height: 320 }}>
        <ResponsiveContainer width="100%" height="100%">
          <LineChart data={sorted} margin={{ top: 8, right: 24, left: 8, bottom: 8 }}>
            <CartesianGrid strokeDasharray="3 3" />
            <XAxis
              dataKey="collected_at"
              tickFormatter={(v: string) => formatTimestampShort(v)}
              tick={{ fontSize: 11 }}
              minTickGap={40}
            />
            <YAxis
              tick={{ fontSize: 11 }}
              label={
                chart.unit
                  ? { value: chart.unit, angle: -90, position: 'insideLeft', fontSize: 12 }
                  : undefined
              }
            />
            <Tooltip
              labelFormatter={(v: string) => formatTimestamp(v)}
              formatter={(value: number) =>
                chart.unit ? [`${value.toLocaleString()} ${chart.unit}`, chart.label] : [value.toLocaleString(), chart.label]
              }
            />
            <Line
              type="monotone"
              dataKey={chart.dataKey}
              stroke={chart.color}
              strokeWidth={2}
              dot={{ r: 2 }}
              activeDot={{ r: 5 }}
            />
          </LineChart>
        </ResponsiveContainer>
      </Box>
    </Paper>
  );
}
</file>

<file path="SQLPulseUI/src/components/query-history/RegressionCard.tsx">
import {
  Paper,
  Typography,
  Box,
  Chip,
} from '@mui/material';
import { formatFloat } from '../../utils/formatters';
import type { QueryMetricRecord, QueryBaselineResponse, BaselineStatistic } from '../../types/history';

interface Props {
  baseline: QueryBaselineResponse;
  latestSample: QueryMetricRecord | null;
}

interface RegressionRow {
  label: string;
  currentValue: number;
  stat: BaselineStatistic;
}

const METRIC_MAP: { metricKey: string; sampleKey: keyof QueryMetricRecord; label: string }[] = [
  { metricKey: 'avg_elapsed_ms', sampleKey: 'avg_elapsed_time_ms', label: 'Avg Duration (ms)' },
  { metricKey: 'avg_cpu_ms', sampleKey: 'avg_cpu_time_ms', label: 'Avg CPU (ms)' },
  { metricKey: 'avg_logical_reads', sampleKey: 'avg_logical_reads', label: 'Avg Logical Reads' },
];

function MultiplierChip({ value }: { value: number }) {
  const color = value >= 3 ? 'error' : value >= 1.5 ? 'warning' : 'success';
  return (
    <Chip
      label={`${formatFloat(value, 2)}×`}
      color={color}
      size="small"
      variant="outlined"
    />
  );
}

export default function RegressionCard({ baseline, latestSample }: Props) {
  if (baseline.baseline_status === 'INSUFFICIENT_DATA' || !latestSample) {
    return null;
  }

  const rows: RegressionRow[] = [];
  for (const m of METRIC_MAP) {
    const stat = baseline.metrics[m.metricKey];
    if (!stat || stat.sample_count < 2) continue;
    const current = latestSample[m.sampleKey] as number;
    if (typeof current !== 'number') continue;
    rows.push({ label: m.label, currentValue: current, stat });
  }

  if (rows.length === 0) return null;

  return (
    <Paper variant="outlined" sx={{ p: 2 }}>
      <Typography variant="subtitle1" fontWeight={600} gutterBottom>
        Regression Comparison
      </Typography>
      <Typography variant="body2" color="text.secondary" sx={{ mb: 2 }}>
        Latest sample vs {baseline.window} baseline
      </Typography>

      <Box sx={{ display: 'flex', flexDirection: 'column', gap: 2 }}>
        {rows.map((row) => {
          const multiplierMean = row.stat.mean > 0 ? row.currentValue / row.stat.mean : 0;
          const multiplierP95 = row.stat.p95 > 0 ? row.currentValue / row.stat.p95 : 0;
          return (
            <Box
              key={row.label}
              sx={{
                display: 'flex',
                flexWrap: 'wrap',
                gap: 3,
                alignItems: 'center',
                p: 1.5,
                borderRadius: 1,
                bgcolor: 'action.hover',
              }}
            >
              <Box sx={{ minWidth: 160 }}>
                <Typography variant="caption" color="text.secondary">
                  Metric
                </Typography>
                <Typography variant="body2" fontWeight={600}>
                  {row.label}
                </Typography>
              </Box>
              <Box sx={{ minWidth: 90 }}>
                <Typography variant="caption" color="text.secondary">
                  Current
                </Typography>
                <Typography variant="body2" fontWeight={600}>
                  {formatFloat(row.currentValue, 2)}
                </Typography>
              </Box>
              <Box sx={{ minWidth: 90 }}>
                <Typography variant="caption" color="text.secondary">
                  Historical Mean
                </Typography>
                <Typography variant="body2">
                  {formatFloat(row.stat.mean, 2)}
                </Typography>
              </Box>
              <Box sx={{ minWidth: 90 }}>
                <Typography variant="caption" color="text.secondary">
                  Historical P95
                </Typography>
                <Typography variant="body2">
                  {formatFloat(row.stat.p95, 2)}
                </Typography>
              </Box>
              <Box sx={{ minWidth: 80 }}>
                <Typography variant="caption" color="text.secondary">
                  vs Mean
                </Typography>
                <Box>{multiplierMean > 0 && <MultiplierChip value={multiplierMean} />}</Box>
              </Box>
              <Box sx={{ minWidth: 80 }}>
                <Typography variant="caption" color="text.secondary">
                  vs P95
                </Typography>
                <Box>{multiplierP95 > 0 && <MultiplierChip value={multiplierP95} />}</Box>
              </Box>
            </Box>
          );
        })}
      </Box>
    </Paper>
  );
}
</file>

<file path="SQLPulseUI/src/components/slow-queries/QueryStoreStatusBadge.tsx">
import { Chip, Tooltip } from '@mui/material';
import type { QueryStoreStatus } from '../../types/history';

const statusConfig: Record<QueryStoreStatus, { label: string; color: 'success' | 'warning' | 'error' | 'default'; tip: string }> = {
  AVAILABLE: {
    label: 'Query Store Available',
    color: 'success',
    tip: 'Query Store is enabled and collecting data.',
  },
  AVAILABLE_READ_ONLY: {
    label: 'Query Store (Read Only)',
    color: 'warning',
    tip: 'Query Store is available in read-only mode. New data is not being collected.',
  },
  DISABLED: {
    label: 'Query Store Disabled',
    color: 'error',
    tip: 'Query Store is disabled on this database. Enable it to use slow-query analysis.',
  },
  PERMISSION_DENIED: {
    label: 'Permission Denied',
    color: 'error',
    tip: 'Insufficient permissions to access Query Store. Contact your DBA.',
  },
  QUERY_FAILED: {
    label: 'Query Failed',
    color: 'error',
    tip: 'The Query Store query failed. Check database status and permissions.',
  },
};

interface Props {
  status: QueryStoreStatus;
}

export default function QueryStoreStatusBadge({ status }: Props) {
  const cfg = statusConfig[status] ?? { label: status, color: 'default' as const, tip: '' };
  return (
    <Tooltip title={cfg.tip} arrow>
      <Chip label={cfg.label} size="small" color={cfg.color} variant="outlined" />
    </Tooltip>
  );
}
