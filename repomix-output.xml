<file path="SQLPulseAPI.Net8/Services/History/BaselineService.cs">
using Microsoft.Extensions.Options;
using SQLPulseAPI.Net8.Configuration;
using SQLPulseAPI.Net8.Models.History;
using SQLPulseAPI.Net8.Repositories;

namespace SQLPulseAPI.Net8.Services.History;

/// <summary>
/// Calculates statistical baselines for a query from stored history.
/// </summary>
public interface IBaselineService
{
    /// <summary>
    /// Calculates the baseline for a query over a time window.
    /// </summary>
    /// <param name="queryHash">Query hash to baseline.</param>
    /// <param name="database">Database the samples were recorded against.</param>
    /// <param name="window">Time window: <c>1h</c>, <c>24h</c>, <c>7d</c> or <c>30d</c>.</param>
    /// <param name="minSamples">
    /// Overrides the configured minimum; below it the baseline is reported as
    /// <see cref="BaselineStatus.InsufficientData"/> with no metrics.
    /// </param>
    /// <param name="cancellationToken">Cancellation token.</param>
    /// <exception cref="ArgumentException">The window is not supported.</exception>
    Task<QueryBaseline> CalculateAsync(
        string queryHash,
        string database,
        string window = BaselineService.DefaultWindow,
        int? minSamples = null,
        CancellationToken cancellationToken = default);

    /// <summary>
    /// Returns a baseline only when it is <see cref="BaselineStatus.Ready"/>, otherwise
    /// <see langword="null"/>.
    /// </summary>
    /// <remarks>
    /// Regression detection must never compare against an unusable baseline, so the
    /// "not enough data" case is expressed as the absence of a baseline rather than as a
    /// baseline the caller has to remember to check.
    /// </remarks>
    Task<QueryBaseline?> GetForRegressionAsync(
        string queryHash,
        string database,
        string window = BaselineService.DefaultWindow,
        int? minSamples = null,
        CancellationToken cancellationToken = default);
}

/// <summary>
/// Deterministic baseline calculation.
/// Ported from <c>BaselineService</c> in <c>app/storage/baseline_service.py</c>.
/// </summary>
/// <remarks>
/// Every number here is computed arithmetically from stored samples. No LLM is involved:
/// a baseline is evidence, and evidence has to be reproducible.
/// </remarks>
public sealed class BaselineService(
    IHistoryRepository repository,
    IOptions<HistoryOptions> historyOptions,
    ILogger<BaselineService> logger) : IBaselineService
{
    /// <summary>Window used when the caller does not specify one.</summary>
    public const string DefaultWindow = "7d";

    /// <summary>Supported windows and their length in hours. Python: <c>WINDOW_HOURS</c>.</summary>
    private static readonly Dictionary<string, int> WindowHours = new(StringComparer.Ordinal)
    {
        ["1h"] = 1,
        ["24h"] = 24,
        ["7d"] = 168,
        ["30d"] = 720,
    };

    private readonly HistoryOptions _history = historyOptions.Value;

    /// <summary>Window names accepted by <see cref="CalculateAsync"/>, sorted for display.</summary>
    public static IReadOnlyList<string> SupportedWindows { get; } =
        WindowHours.Keys.OrderBy(k => k, StringComparer.Ordinal).ToArray();

    /// <summary>Returns whether <paramref name="window"/> is a supported window name.</summary>
    public static bool IsSupportedWindow(string? window) =>
        window is not null && WindowHours.ContainsKey(window);

    /// <inheritdoc />
    public async Task<QueryBaseline> CalculateAsync(
        string queryHash,
        string database,
        string window = DefaultWindow,
        int? minSamples = null,
        CancellationToken cancellationToken = default)
    {
        if (!WindowHours.TryGetValue(window, out var hours))
        {
            throw new ArgumentException(
                $"Unsupported window '{window}'. Use one of: {string.Join(", ", SupportedWindows)}",
                nameof(window));
        }

        var required = minSamples ?? _history.BaselineMinSamples;
        var since = DateTimeOffset.UtcNow.AddHours(-hours);

        var records = await repository.GetQuerySamplesAsync(queryHash, database, since, cancellationToken);

        var baseline = new QueryBaseline
        {
            QueryHash = queryHash,
            Database = database,
            Server = records.Count > 0 ? records[0].Server : string.Empty,
            Window = window,
            SampleCount = records.Count,
        };

        if (records.Count < required)
        {
            // Deliberately leaves every statistic null. Zero-filled statistics would be
            // indistinguishable from a query that genuinely measured zero, and any
            // current value would then look like an infinite regression.
            baseline.BaselineStatus = BaselineStatus.InsufficientData;
            return baseline;
        }

        baseline.BaselineStatus = BaselineStatus.Ready;
        baseline.AvgCpuMs = BaselineStatistics.Compute(records.Select(r => r.AvgCpuTimeMs).ToArray());
        baseline.AvgElapsedMs = BaselineStatistics.Compute(records.Select(r => r.AvgElapsedTimeMs).ToArray());
        baseline.AvgLogicalReads = BaselineStatistics.Compute(records.Select(r => r.AvgLogicalReads).ToArray());
        baseline.AvgPhysicalReads = BaselineStatistics.Compute(records.Select(r => r.AvgPhysicalReads).ToArray());
        baseline.ExecutionCount = BaselineStatistics.Compute(records.Select(r => (double)r.ExecutionCount).ToArray());

        return baseline;
    }

    /// <inheritdoc />
    public async Task<QueryBaseline?> GetForRegressionAsync(
        string queryHash,
        string database,
        string window = DefaultWindow,
        int? minSamples = null,
        CancellationToken cancellationToken = default)
    {
        try
        {
            var baseline = await CalculateAsync(queryHash, database, window, minSamples, cancellationToken);
            return baseline.BaselineStatus == BaselineStatus.Ready ? baseline : null;
        }
        catch (Exception exception)
        {
            // Missing history is the normal state on a new install. Failing detection
            // because of it would remove findings that do not depend on history at all.
            logger.LogDebug(
                exception,
                "Baseline lookup failed for {QueryHash} in {Database}",
                queryHash,
                database);
            return null;
        }
    }
}
</file>

<file path="SQLPulseAPI.Net8/Services/History/BaselineStatistics.cs">
using SQLPulseAPI.Net8.Models.History;

namespace SQLPulseAPI.Net8.Services.History;

/// <summary>
/// Descriptive statistics for baseline calculation.
/// Ported from <c>_compute_statistic</c> in <c>app/storage/baseline_service.py</c>.
/// </summary>
/// <remarks>
/// Purely arithmetic and deterministic. No LLM is involved in any calculation here or
/// anywhere else in the history layer.
/// </remarks>
public static class BaselineStatistics
{
    /// <summary>Results are rounded to this many decimals, matching the Python reference.</summary>
    private const int Decimals = 2;

    /// <summary>
    /// Computes statistics over <paramref name="values"/>.
    /// </summary>
    /// <returns>
    /// <see langword="null"/> when there are no values. A caller must not receive a
    /// zero-filled statistic for an empty set, because "no data" and "measured zero" are
    /// different facts and a zero baseline would make any current value look like an
    /// infinite regression.
    /// </returns>
    public static BaselineStatistic? Compute(IReadOnlyList<double> values)
    {
        if (values.Count == 0)
        {
            return null;
        }

        var n = values.Count;
        var sorted = values.OrderBy(v => v).ToArray();

        var mean = values.Sum() / n;
        var median = n % 2 != 0
            ? sorted[n / 2]
            : (sorted[(n / 2) - 1] + sorted[n / 2]) / 2;

        // Sample standard deviation (n-1). These readings are a sample of the query's
        // behaviour, not its complete population, so Bessel's correction applies.
        // A single sample has no spread to measure, so it reports 0 rather than dividing
        // by zero.
        var standardDeviation = 0.0;
        if (n > 1)
        {
            var variance = values.Sum(v => (v - mean) * (v - mean)) / (n - 1);
            standardDeviation = Math.Sqrt(variance);
        }

        // Nearest-rank percentile: index ceil(0.95 * n) - 1, clamped to the last element.
        var p95Index = Math.Min((int)Math.Ceiling(0.95 * n) - 1, n - 1);

        return new BaselineStatistic
        {
            SampleCount = n,
            Mean = Round(mean),
            Median = Round(median),
            Minimum = Round(sorted[0]),
            Maximum = Round(sorted[^1]),
            StandardDeviation = Round(standardDeviation),
            // P50 is the median by definition; both are exposed because the API contract
            // carries both names.
            P50 = Round(median),
            P95 = Round(sorted[p95Index]),
        };
    }

    /// <summary>
    /// Rounds to <see cref="Decimals"/> places using banker's rounding, matching Python's
    /// built-in <c>round()</c> so the two implementations agree on exact midpoints.
    /// </summary>
    private static double Round(double value) => Math.Round(value, Decimals, MidpointRounding.ToEven);
}
</file>

<file path="SQLPulseAPI.Net8/Services/History/HistoryService.cs">
using Microsoft.Extensions.Options;
using SQLPulseAPI.Net8.Configuration;
using SQLPulseAPI.Net8.Models.History;
using SQLPulseAPI.Net8.Models.Performance;
using SQLPulseAPI.Net8.Repositories;

namespace SQLPulseAPI.Net8.Services.History;

/// <summary>
/// Persists collected snapshots into SQLPulse's own historical storage.
/// </summary>
public interface IHistoryService
{
    /// <summary>
    /// Persists a snapshot and its query metrics. Never throws.
    /// </summary>
    Task PersistSnapshotAsync(PerformanceSnapshot snapshot, CancellationToken cancellationToken = default);

    /// <summary>Deletes history older than the retention window and returns the number of samples removed.</summary>
    Task<int> RunRetentionCleanupAsync(int? retentionDays = null, CancellationToken cancellationToken = default);
}

/// <summary>
/// Snapshot persistence.
/// Ported from <c>HistoryService</c> in <c>app/storage/history_service.py</c>.
/// </summary>
public sealed class HistoryService(
    IHistoryRepository repository,
    IOptions<HistoryOptions> historyOptions,
    ILogger<HistoryService> logger) : IHistoryService
{
    /// <summary>
    /// Characters of SQL retained per sample.
    /// </summary>
    /// <remarks>
    /// A preview, not the statement: history is for spotting that a query changed shape,
    /// and storing full text would retain literal values from the monitored workload
    /// indefinitely.
    /// </remarks>
    private const int SqlPreviewLength = 200;

    /// <summary>
    /// Grouping key used when a sample's database cannot be determined.
    /// </summary>
    /// <remarks>
    /// Storage needs a non-null key to group samples by. The Python original uses
    /// <c>"unknown"</c>, which is a legal SQL Server database name and would silently
    /// merge with a real database called <c>unknown</c>. The parenthesised marker cannot
    /// be a database name, so the ambiguity is impossible.
    /// </remarks>
    public const string UnresolvedDatabase = "(unresolved)";

    private readonly HistoryOptions _history = historyOptions.Value;

    /// <inheritdoc />
    public async Task PersistSnapshotAsync(
        PerformanceSnapshot snapshot,
        CancellationToken cancellationToken = default)
    {
        try
        {
            // Re-persisting the same snapshot would duplicate every sample and inflate
            // baseline sample counts, making a query look better-established than it is.
            if (await repository.SnapshotExistsAsync(snapshot.SnapshotId, cancellationToken))
            {
                logger.LogDebug("Snapshot {SnapshotId} already persisted; skipping", snapshot.SnapshotId);
                return;
            }

            await repository.SaveSnapshotAsync(
                new SnapshotRecord
                {
                    SnapshotId = snapshot.SnapshotId,
                    CollectedAt = snapshot.CollectedAt,
                    Server = snapshot.ServerHost,
                    Scope = snapshot.Scope == AnalysisScope.Database ? "database" : "server",
                    Database = snapshot.Database,
                },
                cancellationToken);

            var metrics = ExtractMetrics(snapshot);
            if (metrics.Count > 0)
            {
                await repository.SaveQueryMetricsAsync(metrics, cancellationToken);
            }

            logger.LogDebug(
                "Persisted snapshot {SnapshotId} with {Count} query metric(s)",
                snapshot.SnapshotId,
                metrics.Count);
        }
        catch (Exception exception)
        {
            // History is a supporting capability. Losing a sample must never turn a
            // successful monitoring call into a failed one.
            logger.LogWarning(
                exception,
                "Non-fatal: failed to persist snapshot {SnapshotId}",
                snapshot.SnapshotId);
        }
    }

    /// <inheritdoc />
    public async Task<int> RunRetentionCleanupAsync(
        int? retentionDays = null,
        CancellationToken cancellationToken = default)
    {
        var days = retentionDays ?? _history.RetentionDays;

        try
        {
            var removed = await repository.RunRetentionCleanupAsync(days, cancellationToken);
            logger.LogInformation("Retention cleanup removed {Count} sample(s) older than {Days}d", removed, days);
            return removed;
        }
        catch (Exception exception)
        {
            logger.LogWarning(exception, "Non-fatal: retention cleanup failed");
            return 0;
        }
    }

    /// <summary>
    /// Builds the per-query samples for a snapshot from the CPU and I/O sections.
    /// </summary>
    /// <remarks>
    /// The two sections describe the same queries from different angles, so a query
    /// appearing in both must become one sample carrying both sets of metrics rather
    /// than two partial samples that would each distort its baseline.
    /// </remarks>
    internal static List<QueryMetricRecord> ExtractMetrics(PerformanceSnapshot snapshot)
    {
        var byHash = new Dictionary<string, QueryMetricRecord>(StringComparer.Ordinal);
        var ordered = new List<QueryMetricRecord>();

        var cpuSection = snapshot.TopCpuQueries;
        if (cpuSection is not null && cpuSection.Metadata.Success)
        {
            foreach (var query in cpuSection.Queries)
            {
                if (string.IsNullOrEmpty(query.QueryHash) || byHash.ContainsKey(query.QueryHash))
                {
                    continue;
                }

                var record = new QueryMetricRecord
                {
                    SnapshotId = snapshot.SnapshotId,
                    CollectedAt = snapshot.CollectedAt,
                    Server = snapshot.ServerHost,
                    Database = ResolveDatabase(query.DatabaseName, snapshot.Database),
                    QueryHash = query.QueryHash,
                    SqlTextPreview = Preview(query.SqlText),
                    ExecutionCount = query.ExecutionCount,
                    TotalCpuTimeMs = query.TotalCpuTimeMs,
                    AvgCpuTimeMs = query.AvgCpuTimeMs,
                    TotalElapsedTimeMs = query.TotalElapsedTimeMs,
                    AvgElapsedTimeMs = query.AvgElapsedTimeMs,
                    TotalLogicalReads = query.TotalLogicalReads,
                    AvgLogicalReads = query.AvgLogicalReads,
                };

                byHash[query.QueryHash] = record;
                ordered.Add(record);
            }
        }

        var ioSection = snapshot.TopIoQueries;
        if (ioSection is not null && ioSection.Metadata.Success)
        {
            foreach (var query in ioSection.Queries)
            {
                if (string.IsNullOrEmpty(query.QueryHash))
                {
                    continue;
                }

                if (byHash.TryGetValue(query.QueryHash, out var existing))
                {
                    existing.TotalPhysicalReads = query.TotalPhysicalReads;
                    existing.AvgPhysicalReads = query.AvgPhysicalReads;
                    existing.TotalLogicalWrites = query.TotalLogicalWrites;
                    existing.AvgLogicalWrites = query.AvgLogicalWrites;

                    // The I/O collector orders by reads, so its figure for a query is the
                    // more complete one when it is larger. Taking the smaller value would
                    // understate the query in its own baseline.
                    if (query.TotalLogicalReads > existing.TotalLogicalReads)
                    {
                        existing.TotalLogicalReads = query.TotalLogicalReads;
                        existing.AvgLogicalReads = query.AvgLogicalReads;
                    }

                    continue;
                }

                // I/O-only query: CPU and elapsed metrics are genuinely unmeasured here
                // and stay at zero rather than being invented.
                var record = new QueryMetricRecord
                {
                    SnapshotId = snapshot.SnapshotId,
                    CollectedAt = snapshot.CollectedAt,
                    Server = snapshot.ServerHost,
                    Database = ResolveDatabase(query.DatabaseName, snapshot.Database),
                    QueryHash = query.QueryHash,
                    SqlTextPreview = Preview(query.SqlText),
                    ExecutionCount = query.ExecutionCount,
                    TotalElapsedTimeMs = query.TotalElapsedTimeMs,
                    TotalLogicalReads = query.TotalLogicalReads,
                    AvgLogicalReads = query.AvgLogicalReads,
                    TotalPhysicalReads = query.TotalPhysicalReads,
                    AvgPhysicalReads = query.AvgPhysicalReads,
                    TotalLogicalWrites = query.TotalLogicalWrites,
                    AvgLogicalWrites = query.AvgLogicalWrites,
                };

                byHash[query.QueryHash] = record;
                ordered.Add(record);
            }
        }

        return ordered;
    }

    /// <summary>
    /// Chooses the database a sample is filed under: the query's own database, else the
    /// snapshot's, else <see cref="UnresolvedDatabase"/>.
    /// </summary>
    internal static string ResolveDatabase(string? queryDatabase, string? snapshotDatabase)
    {
        if (!string.IsNullOrEmpty(queryDatabase))
        {
            return queryDatabase;
        }

        return string.IsNullOrEmpty(snapshotDatabase) ? UnresolvedDatabase : snapshotDatabase;
    }

    private static string? Preview(string? sqlText)
    {
        if (string.IsNullOrEmpty(sqlText))
        {
            return null;
        }

        return sqlText.Length <= SqlPreviewLength ? sqlText : sqlText[..SqlPreviewLength];
    }
}
