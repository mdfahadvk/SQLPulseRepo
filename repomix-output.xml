<file path="SQLPulseAPI.Net8/Services/Agent/LlmContracts.cs">
using System.Text.Json.Nodes;

namespace SQLPulseAPI.Net8.Services.Agent;

/// <summary>
/// A single message in a conversation with the model.
/// Ported from <c>LLMMessage</c> in <c>app/agent/llm_provider.py</c>.
/// </summary>
public sealed class LlmMessage
{
    /// <summary>One of <c>system</c>, <c>user</c>, <c>assistant</c> or <c>tool</c>.</summary>
    public required string Role { get; init; }

    /// <summary>Message content. Null on an assistant turn that only requests tool calls.</summary>
    public string? Content { get; init; }

    /// <summary>Tool calls requested by the assistant.</summary>
    public IReadOnlyList<LlmToolCall>? ToolCalls { get; init; }

    /// <summary>Identifier of the tool call this message answers. Set on <c>tool</c> messages.</summary>
    public string? ToolCallId { get; init; }

    /// <summary>Name of the tool that produced this message.</summary>
    public string? Name { get; init; }

    /// <summary>Builds a system message.</summary>
    public static LlmMessage System(string content) => new() { Role = "system", Content = content };

    /// <summary>Builds a user message.</summary>
    public static LlmMessage User(string content) => new() { Role = "user", Content = content };

    /// <summary>Builds an assistant message, optionally carrying requested tool calls.</summary>
    public static LlmMessage Assistant(string? content, IReadOnlyList<LlmToolCall>? toolCalls = null) =>
        new() { Role = "assistant", Content = content, ToolCalls = toolCalls };

    /// <summary>Builds the tool-result message that answers a specific tool call.</summary>
    public static LlmMessage Tool(string content, string toolCallId, string name) =>
        new() { Role = "tool", Content = content, ToolCallId = toolCallId, Name = name };

    /// <summary>
    /// Renders the message in the OpenAI wire format.
    /// Python: <c>LLMMessage.to_dict</c>.
    /// </summary>
    /// <remarks>
    /// Null members are omitted rather than sent as JSON null. Providers reject an
    /// explicit null <c>tool_calls</c>, and the Python reference omits them the same way.
    /// </remarks>
    public JsonObject ToWire()
    {
        var wire = new JsonObject { ["role"] = Role };

        if (Content is not null)
        {
            wire["content"] = Content;
        }

        if (ToolCalls is not null)
        {
            var calls = new JsonArray();
            foreach (var call in ToolCalls)
            {
                calls.Add(call.ToWire());
            }

            wire["tool_calls"] = calls;
        }

        if (ToolCallId is not null)
        {
            wire["tool_call_id"] = ToolCallId;
        }

        if (Name is not null)
        {
            wire["name"] = Name;
        }

        return wire;
    }
}

/// <summary>
/// A tool invocation requested by the model.
/// </summary>
/// <param name="Id">Provider-assigned call identifier, echoed back on the tool result.</param>
/// <param name="FunctionName">Name of the tool the model wants to run.</param>
/// <param name="ArgumentsJson">Raw JSON arguments exactly as the model produced them.</param>
/// <remarks>
/// Arguments stay as text here because the model can emit malformed JSON. Parsing is the
/// caller's job so a bad argument payload becomes a handled tool error rather than a
/// deserialization failure that aborts the investigation.
/// </remarks>
public sealed record LlmToolCall(string Id, string FunctionName, string ArgumentsJson)
{
    /// <summary>The only tool type OpenAI-compatible providers support.</summary>
    public const string FunctionType = "function";

    /// <summary>Renders the call in the OpenAI wire format.</summary>
    public JsonObject ToWire() => new()
    {
        ["id"] = Id,
        ["type"] = FunctionType,
        ["function"] = new JsonObject
        {
            ["name"] = FunctionName,
            ["arguments"] = ArgumentsJson,
        },
    };
}

/// <summary>
/// Schema for a tool the model may call.
/// Ported from <c>ToolDefinition</c> in <c>app/agent/llm_provider.py</c>.
/// </summary>
public sealed class LlmToolDefinition
{
    /// <summary>Tool name the model uses to invoke it.</summary>
    public required string Name { get; init; }

    /// <summary>Description the model reads when choosing a tool.</summary>
    public required string Description { get; init; }

    /// <summary>JSON Schema describing the tool's parameters.</summary>
    public required JsonObject Parameters { get; init; }

    /// <summary>
    /// Renders the definition as an OpenAI function-calling schema.
    /// Python: <c>ToolDefinition.to_openai_schema</c>.
    /// </summary>
    /// <remarks>
    /// <see cref="Parameters"/> is deep-cloned because a <see cref="JsonNode"/> may only be
    /// attached to one parent, and these definitions are static and reused on every request.
    /// </remarks>
    public JsonObject ToOpenAiSchema() => new()
    {
        ["type"] = LlmToolCall.FunctionType,
        ["function"] = new JsonObject
        {
            ["name"] = Name,
            ["description"] = Description,
            ["parameters"] = Parameters.DeepClone(),
        },
    };
}

/// <summary>
/// A provider-independent model response.
/// Ported from <c>LLMResponse</c> in <c>app/agent/llm_provider.py</c>.
/// </summary>
/// <param name="Content">Assistant content, if any.</param>
/// <param name="ToolCalls">Tool calls the model requested.</param>
/// <param name="FinishReason">Provider-reported finish reason.</param>
public sealed record LlmCompletion(
    string? Content,
    IReadOnlyList<LlmToolCall> ToolCalls,
    string FinishReason)
{
    /// <summary>An empty completion, used when a provider returns no choices.</summary>
    public static LlmCompletion Empty { get; } = new(null, [], "stop");

    /// <summary>True when the model asked for at least one tool call.</summary>
    public bool HasToolCalls => ToolCalls.Count > 0;
}
</file>

<file path="SQLPulseAPI.Net8/Services/Agent/LlmExceptions.cs">
namespace SQLPulseAPI.Net8.Services.Agent;

/// <summary>
/// A recoverable LLM provider failure.
/// Ported from <c>LLMError</c> in <c>app/agent/llm_provider.py</c>.
/// </summary>
/// <remarks>
/// Vendor exception types are translated into this hierarchy at the HTTP boundary so the
/// rest of SQLPulse reacts to the failures that actually need different handling, without
/// depending on any single provider's SDK.
/// </remarks>
public class LlmException(string message, Exception? innerException = null)
    : Exception(message, innerException);

/// <summary>
/// The provider rejected the request because a rate limit was exceeded (HTTP 429).
/// Python: <c>LLMRateLimitError</c>.
/// </summary>
/// <remarks>
/// Distinct from <see cref="LlmPayloadTooLargeException"/> because the fix is different:
/// a plain rate limit is fixed by waiting, an oversized request by sending less.
/// </remarks>
public sealed class LlmRateLimitException(string message, TimeSpan? retryAfter = null, Exception? innerException = null)
    : LlmException(message, innerException)
{
    /// <summary>Provider-supplied <c>Retry-After</c> hint, when one was sent.</summary>
    public TimeSpan? RetryAfter { get; } = retryAfter;
}

/// <summary>
/// The request exceeded the provider's per-request or per-minute token budget.
/// Python: <c>LLMPayloadTooLargeError</c>.
/// </summary>
/// <remarks>
/// Raised for HTTP 413, for a 429 whose body names the token-per-minute quota, and for a
/// 400 reporting an exceeded context length. All three are fixed by sending less, so the
/// caller can compact the conversation and retry rather than giving up.
/// </remarks>
public sealed class LlmPayloadTooLargeException(string message, Exception? innerException = null)
    : LlmException(message, innerException);

/// <summary>The provider could not be reached, or returned a server-side error.</summary>
public sealed class LlmUnavailableException(string message, Exception? innerException = null)
    : LlmException(message, innerException);

/// <summary>The provider did not respond within the configured request timeout.</summary>
public sealed class LlmTimeoutException(string message, Exception? innerException = null)
    : LlmException(message, innerException);

/// <summary>The provider rejected the configured credentials.</summary>
public sealed class LlmAuthenticationException(string message, Exception? innerException = null)
    : LlmException(message, innerException);

/// <summary>The provider rejected the request as invalid.</summary>
public sealed class LlmInvalidRequestException(string message, Exception? innerException = null)
    : LlmException(message, innerException);

/// <summary>
/// No LLM provider or API key is configured.
/// </summary>
/// <remarks>
/// Reported as its own failure so the caller can say "AI features are not configured"
/// instead of surfacing a provider authentication error, which would suggest a wrong key
/// rather than a missing one.
/// </remarks>
public sealed class LlmNotConfiguredException(string message)
    : LlmException(message);
</file>

<file path="SQLPulseAPI.Net8/Services/Agent/LlmSanitizer.cs">
using System.Text.Json.Nodes;
using System.Text.RegularExpressions;

namespace SQLPulseAPI.Net8.Services.Agent;

/// <summary>
/// Strips credentials and trims oversized payloads before anything reaches the LLM
/// provider. Ported from <c>app/agent/sanitizer.py</c>.
/// </summary>
/// <remarks>
/// <para>
/// Every byte handed to a third-party model leaves SQLPulse's trust boundary, so tool
/// output passes through here first. Two separate concerns are handled: removing secrets,
/// which is a security requirement, and shrinking payloads, which keeps a single large
/// snapshot from exhausting the provider's token budget.
/// </para>
/// <para>
/// The SQL password, the full connection string and the LLM API key are never placed in a
/// tool result to begin with; this is the second line of defence.
/// </para>
/// </remarks>
public static partial class LlmSanitizer
{
    /// <summary>Replacement written in place of any secret.</summary>
    public const string Redacted = "[REDACTED]";

    /// <summary>Marks a payload that was shortened to fit the token budget.</summary>
    public const string TruncatedFlag = "_truncated";

    private const string TruncationNoteKey = "_truncation_note";

    private const string TruncationNote =
        "Results were truncated to fit the model's token budget. "
        + "Counts in this payload reflect the full result set; the item "
        + "lists show only the highest-priority entries.";

    /// <summary>Closes the JSON object so a hard-cut payload still parses, and flags the cut.</summary>
    private const string HardCutSuffix = "...\"_truncated\":true}";

    private const string TruncationSuffix = "\u2026[truncated]";

    private const int VerboseTextLimit = 300;

    private const int DefaultSanitizeDepth = 6;

    private const int DefaultTrimDepth = 8;

    /// <summary>Number of shrink passes before falling back to a hard cut.</summary>
    private const int MaxShrinkPasses = 8;

    /// <summary>
    /// Property names whose value is replaced outright, whatever it contains.
    /// </summary>
    /// <remarks>
    /// Matching is on the name rather than the value because a secret is not always
    /// recognisable: an API key is just a string of characters.
    /// </remarks>
    private static readonly HashSet<string> SensitiveKeys = new(StringComparer.OrdinalIgnoreCase)
    {
        "password", "pwd", "secret", "api_key", "apikey",
        "connection_string", "conn_str", "sql_password",
        "token", "access_token", "refresh_token",
    };

    /// <summary>
    /// Fields that routinely carry multi-kilobyte SQL or plan text. Only a preview is ever
    /// useful to the model, and full text quickly exhausts the token budget.
    /// </summary>
    private static readonly HashSet<string> VerboseTextKeys = new(StringComparer.OrdinalIgnoreCase)
    {
        "sql_text", "sql_text_preview", "query_text", "statement_text",
        "query_sql_text", "command_text", "batch_text", "query_plan",
        "plan_xml", "execution_plan",
    };

    private static readonly Regex[] SensitivePatterns =
    [
        PasswordAssignment(),
        ApiKeyAssignment(),
        BearerToken(),
        ConnectionStringAssignment(),
        UidPwdPair(),
        ServerPwdPair(),
    ];

    /// <summary>Removes sensitive values from a text string. Python: <c>sanitize_text</c>.</summary>
    public static string SanitizeText(string? text)
    {
        if (string.IsNullOrEmpty(text))
        {
            return text ?? string.Empty;
        }

        var result = text;
        foreach (var pattern in SensitivePatterns)
        {
            result = pattern.Replace(result, Redacted);
        }

        return result;
    }

    /// <summary>
    /// Recursively redacts sensitive keys and values. Python: <c>sanitize_dict</c>.
    /// </summary>
    /// <param name="node">Node to sanitize. Never mutated; a new tree is returned.</param>
    /// <param name="maxDepth">Recursion limit, guarding against pathological nesting.</param>
    /// <remarks>
    /// Unlike the Python reference, strings nested inside arrays are sanitized too. The
    /// reference copies them through untouched, which would let a credential inside a list
    /// of strings reach the provider.
    /// </remarks>
    public static JsonNode? Sanitize(JsonNode? node, int maxDepth = DefaultSanitizeDepth)
    {
        if (maxDepth <= 0)
        {
            return new JsonObject { [TruncatedFlag] = true };
        }

        switch (node)
        {
            case JsonObject source:
            {
                var sanitized = new JsonObject();
                foreach (var (key, value) in source)
                {
                    sanitized[key] = SensitiveKeys.Contains(NormalizeKey(key))
                        ? Redacted
                        : Sanitize(value, maxDepth - 1);
                }

                return sanitized;
            }

            case JsonArray source:
            {
                var sanitized = new JsonArray();
                foreach (var item in source)
                {
                    sanitized.Add(Sanitize(item, maxDepth - 1));
                }

                return sanitized;
            }

            case JsonValue value when value.TryGetValue<string>(out var text):
                return SanitizeText(text);

            default:
                return node?.DeepClone();
        }
    }

    /// <summary>
    /// Prepares tool output for the model: strips credentials, then trims verbose fields.
    /// Python: <c>sanitize_for_llm</c>.
    /// </summary>
    public static JsonObject SanitizeForLlm(JsonObject payload)
    {
        var sanitized = Sanitize(payload) as JsonObject ?? [];
        return TrimVerboseFields(sanitized) as JsonObject ?? [];
    }

    /// <summary>
    /// Recursively shortens known-verbose text fields anywhere in the payload.
    /// Python: <c>_trim_verbose_fields</c>.
    /// </summary>
    public static JsonNode? TrimVerboseFields(JsonNode? node, int maxDepth = DefaultTrimDepth)
    {
        if (maxDepth <= 0)
        {
            return node?.DeepClone();
        }

        switch (node)
        {
            case JsonObject source:
            {
                var trimmed = new JsonObject();
                foreach (var (key, value) in source)
                {
                    if (VerboseTextKeys.Contains(key)
                        && value is JsonValue candidate
                        && candidate.TryGetValue<string>(out var text)
                        && text.Length > VerboseTextLimit)
                    {
                        var keep = VerboseTextLimit - TruncationSuffix.Length;
                        trimmed[key] = string.Concat(text.AsSpan(0, keep), TruncationSuffix);
                    }
                    else
                    {
                        trimmed[key] = TrimVerboseFields(value, maxDepth - 1);
                    }
                }

                return trimmed;
            }

            case JsonArray source:
            {
                var trimmed = new JsonArray();
                foreach (var item in source)
                {
                    trimmed.Add(TrimVerboseFields(item, maxDepth - 1));
                }

                return trimmed;
            }

            default:
                return node?.DeepClone();
        }
    }

    /// <summary>
    /// Serialises tool output to JSON, shrinking it to fit <paramref name="maxChars"/>.
    /// Python: <c>serialize_for_llm</c>.
    /// </summary>
    /// <remarks>
    /// An oversized payload is reduced by repeatedly halving its longest array — usually
    /// the culprit — before falling back to a hard cut, so the model still receives
    /// well-formed, representative evidence rather than a truncated fragment. Counts stay
    /// intact, and a note explains that the lists were shortened, so the model does not
    /// report "3 blocking sessions" when there were thirty.
    /// </remarks>
    public static string SerializeForLlm(JsonObject payload, int maxChars)
    {
        var json = payload.ToJsonString();
        if (json.Length <= maxChars)
        {
            return json;
        }

        var shrunk = payload.DeepClone().AsObject();

        for (var pass = 0; pass < MaxShrinkPasses; pass++)
        {
            var longest = LongestArrayKey(shrunk);
            if (longest is null)
            {
                break;
            }

            var array = shrunk[longest]!.AsArray();
            var kept = Math.Max(1, array.Count / 2);
            var reduced = new JsonArray();
            for (var index = 0; index < kept; index++)
            {
                reduced.Add(array[index]?.DeepClone());
            }

            shrunk[longest] = reduced;
            shrunk[TruncatedFlag] = true;
            shrunk[TruncationNoteKey] = TruncationNote;

            json = shrunk.ToJsonString();
            if (json.Length <= maxChars)
            {
                return json;
            }
        }

        var budget = Math.Max(0, maxChars - HardCutSuffix.Length);
        return string.Concat(json.AsSpan(0, Math.Min(budget, json.Length)), HardCutSuffix);
    }

    /// <summary>Name of the longest array with more than one element, or null when none remain.</summary>
    private static string? LongestArrayKey(JsonObject payload)
    {
        string? longest = null;
        var longestCount = 1;

        foreach (var (key, value) in payload)
        {
            if (value is JsonArray array && array.Count > longestCount)
            {
                longest = key;
                longestCount = array.Count;
            }
        }

        return longest;
    }

    /// <summary>Normalises a property name so <c>api-key</c> and <c>api_key</c> match alike.</summary>
    private static string NormalizeKey(string key) => key.Replace('-', '_');

    [GeneratedRegex(@"(password|pwd)\s*=\s*[^\s;]+", RegexOptions.IgnoreCase)]
    private static partial Regex PasswordAssignment();

    [GeneratedRegex(@"(api[_-]?key|secret[_-]?key)\s*=\s*\S+", RegexOptions.IgnoreCase)]
    private static partial Regex ApiKeyAssignment();

    [GeneratedRegex(@"bearer\s+\S+", RegexOptions.IgnoreCase)]
    private static partial Regex BearerToken();

    [GeneratedRegex(@"(connection\s*string|conn\s*str)\s*=\s*.+", RegexOptions.IgnoreCase)]
    private static partial Regex ConnectionStringAssignment();

    [GeneratedRegex(@"UID=\S+;\s*PWD=\S+", RegexOptions.IgnoreCase)]
    private static partial Regex UidPwdPair();

    [GeneratedRegex(@"SERVER=\S+;.*PWD=[^;]+", RegexOptions.IgnoreCase)]
    private static partial Regex ServerPwdPair();
}
</file>

<file path="SQLPulseAPI.Net8/Services/Agent/OpenAiCompatibleLlmClient.cs">
using System.Globalization;
using System.Net;
using System.Net.Http.Headers;
using System.Text;
using System.Text.Json;
using System.Text.Json.Nodes;
using System.Text.RegularExpressions;
using Microsoft.Extensions.Options;
using SQLPulseAPI.Net8.Configuration;

namespace SQLPulseAPI.Net8.Services.Agent;

/// <summary>
/// Talks to any OpenAI-compatible chat-completions endpoint, including Groq.
/// Ported from <c>OpenAIProvider</c> in <c>app/agent/llm_provider.py</c>.
/// </summary>
/// <remarks>
/// <para>
/// OpenAI, Azure OpenAI and Groq all speak the same <c>/chat/completions</c> protocol, so
/// one client covers every supported provider and swapping between them is a configuration
/// change rather than a code change. Talking to the HTTP API directly, instead of a vendor
/// SDK, keeps the dependency surface small and the failure modes explicit.
/// </para>
/// <para>
/// The API key is attached as a request header and never written to a log, an exception
/// message or the payload sent to the model.
/// </para>
/// </remarks>
public sealed partial class OpenAiCompatibleLlmClient(
    IHttpClientFactory httpClientFactory,
    IOptions<LlmOptions> options,
    ILogger<OpenAiCompatibleLlmClient> logger,
    Func<TimeSpan, CancellationToken, Task>? delay = null,
    Func<DateTimeOffset>? utcNow = null) : ILlmClient
{
    /// <summary>Named <see cref="HttpClient"/> registered for LLM traffic.</summary>
    public const string HttpClientName = "SQLPulse.Llm";

    /// <summary>Groq's OpenAI-compatible endpoint. Python: <c>_GROQ_BASE_URL</c>.</summary>
    public const string GroqBaseUrl = "https://api.groq.com/openai/v1";

    /// <summary>Default endpoint when no base URL is configured.</summary>
    public const string OpenAiBaseUrl = "https://api.openai.com/v1";

    private const string CompletionsPath = "chat/completions";

    /// <summary>Caps how much provider error text is copied into an exception or log entry.</summary>
    private const int MaxErrorDetailChars = 500;
    private static readonly TimeSpan[] RateLimitRetryDelays =
    [
        TimeSpan.FromSeconds(2),
        TimeSpan.FromSeconds(5),
        TimeSpan.FromSeconds(10),
    ];
    private static readonly TimeSpan MaxRateLimitDelay = TimeSpan.FromSeconds(30);

    private readonly LlmOptions _options = options.Value;
    private readonly object _cooldownGate = new();
    private readonly Func<TimeSpan, CancellationToken, Task> _delay = delay ?? Task.Delay;
    private readonly Func<DateTimeOffset> _utcNow = utcNow ?? (() => DateTimeOffset.UtcNow);
    private DateTimeOffset? _cooldownUntil;

    /// <inheritdoc />
    public bool IsConfigured => _options.IsConfigured;

    /// <inheritdoc />
    public async Task<LlmCompletion> CompleteAsync(
        IReadOnlyList<LlmMessage> messages,
        IReadOnlyList<LlmToolDefinition>? tools = null,
        CancellationToken cancellationToken = default)
    {
        ArgumentNullException.ThrowIfNull(messages);

        if (!IsConfigured)
        {
            throw new LlmNotConfiguredException(
                "An LLM API key is required but is not configured.");
        }

        if (GetCooldownRemaining() is { } cooldown)
        {
            throw new LlmRateLimitException(
                "AI provider is temporarily rate-limited. Please try again shortly.",
                cooldown);
        }

        var baseUrl = ResolveBaseUrl(_options.Provider, _options.BaseUrl);
        var body = BuildRequestBody(messages, tools);
        var client = httpClientFactory.CreateClient(HttpClientName);

        for (var attempt = 1; ; attempt++)
        {
            using var timeoutSource = new CancellationTokenSource(
                TimeSpan.FromSeconds(_options.RequestTimeoutSeconds));
            using var linkedSource = CancellationTokenSource.CreateLinkedTokenSource(
                cancellationToken, timeoutSource.Token);
            using var request = new HttpRequestMessage(HttpMethod.Post, $"{baseUrl}/{CompletionsPath}")
            {
                Content = new StringContent(body.ToJsonString(), Encoding.UTF8, "application/json"),
            };
            request.Headers.Authorization = new AuthenticationHeaderValue("Bearer", _options.ApiKey);

            try
            {
                using var response = await client.SendAsync(request, linkedSource.Token).ConfigureAwait(false);
                var payload = await response.Content.ReadAsStringAsync(linkedSource.Token)
                    .ConfigureAwait(false);

                if (response.IsSuccessStatusCode)
                {
                    return ParseCompletion(payload);
                }

                var translated = TranslateError(response, payload, _options.Provider, logger);
                if (translated is LlmRateLimitException rateLimit
                    && attempt <= RateLimitRetryDelays.Length)
                {
                    var wait = (rateLimit.RetryAfter ?? RateLimitRetryDelays[attempt - 1]);
                    wait = wait > MaxRateLimitDelay ? MaxRateLimitDelay : wait;

                    logger.LogWarning(
                        "LLM provider {Provider} model {Model} rate-limited on attempt {Attempt}; "
                        + "retrying after {RetryDelayMs}ms",
                        _options.Provider,
                        _options.Model,
                        attempt,
                        (int)wait.TotalMilliseconds);

                    await _delay(wait, cancellationToken).ConfigureAwait(false);
                    continue;
                }

                if (translated is LlmRateLimitException)
                {
                    StartCooldown();
                }

                throw translated;
            }
            catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
            {
                throw;
            }
            catch (OperationCanceledException exception)
            {
                logger.LogWarning(
                    "LLM request to provider '{Provider}' timed out after {TimeoutSeconds}s.",
                    _options.Provider,
                    _options.RequestTimeoutSeconds);

                throw new LlmTimeoutException(
                    $"The LLM provider did not respond within {_options.RequestTimeoutSeconds} seconds.",
                    exception);
            }
            catch (HttpRequestException exception)
            {
                logger.LogWarning(
                    exception,
                    "LLM provider '{Provider}' could not be reached.",
                    _options.Provider);

                throw new LlmUnavailableException(
                    "The LLM provider could not be reached.",
                    exception);
            }
        }
    }

    private TimeSpan? GetCooldownRemaining()
    {
        lock (_cooldownGate)
        {
            if (_cooldownUntil is not { } until)
            {
                return null;
            }

            var remaining = until - _utcNow();
            if (remaining > TimeSpan.Zero)
            {
                return remaining;
            }

            _cooldownUntil = null;
            return null;
        }
    }

    private void StartCooldown()
    {
        var until = _utcNow().AddSeconds(_options.RateLimitCooldownSeconds);
        lock (_cooldownGate)
        {
            _cooldownUntil = until;
        }

        logger.LogWarning(
            "LLM provider {Provider} model {Model} entered cooldown until {CooldownUntil} after rate-limit retries.",
            _options.Provider,
            _options.Model,
            until);
    }

    /// <summary>
    /// Resolves the endpoint for a provider. Python: <c>create_provider</c>.
    /// </summary>
    /// <exception cref="LlmNotConfiguredException">The provider name is not supported.</exception>
    internal static string ResolveBaseUrl(string provider, string? configuredBaseUrl)
    {
        var explicitUrl = string.IsNullOrWhiteSpace(configuredBaseUrl)
            ? null
            : configuredBaseUrl.TrimEnd('/');

        return provider?.Trim().ToLowerInvariant() switch
        {
            "openai" or "azure_openai" => explicitUrl ?? OpenAiBaseUrl,
            "groq" => explicitUrl ?? GroqBaseUrl,
            _ => throw new LlmNotConfiguredException(
                $"Unsupported LLM provider: '{provider}'. Supported: openai, azure_openai, groq"),
        };
    }

    /// <summary>Builds the chat-completions request body. Python: <c>OpenAIProvider.generate</c>.</summary>
    private JsonObject BuildRequestBody(
        IReadOnlyList<LlmMessage> messages,
        IReadOnlyList<LlmToolDefinition>? tools)
    {
        var wireMessages = new JsonArray();
        foreach (var message in messages)
        {
            wireMessages.Add(message.ToWire());
        }

        var body = new JsonObject
        {
            ["model"] = _options.Model,
            ["messages"] = wireMessages,
            ["temperature"] = _options.Temperature,
            ["max_tokens"] = _options.MaxTokens,
        };

        if (tools is { Count: > 0 })
        {
            var wireTools = new JsonArray();
            foreach (var tool in tools)
            {
                wireTools.Add(tool.ToOpenAiSchema());
            }

            body["tools"] = wireTools;

            // "auto" lets the model decide whether evidence is needed; the agent never
            // forces a specific tool.
            body["tool_choice"] = "auto";
        }

        return body;
    }

    /// <summary>Maps a provider response onto the provider-independent completion shape.</summary>
    private static LlmCompletion ParseCompletion(string payload)
    {
        JsonNode? root;
        try
        {
            root = JsonNode.Parse(payload);
        }
        catch (JsonException exception)
        {
            throw new LlmException("The LLM provider returned a malformed response.", exception);
        }

        if (root?["choices"] is not JsonArray { Count: > 0 } choices || choices[0] is not { } choice)
        {
            // A response without choices is not an error, just nothing to act on.
            return LlmCompletion.Empty;
        }

        var message = choice["message"];
        var content = message?["content"]?.GetValue<string>();
        var finishReason = choice["finish_reason"]?.GetValue<string>();

        var toolCalls = new List<LlmToolCall>();
        if (message?["tool_calls"] is JsonArray rawCalls)
        {
            foreach (var rawCall in rawCalls)
            {
                var function = rawCall?["function"];
                var name = function?["name"]?.GetValue<string>();
                if (string.IsNullOrWhiteSpace(name))
                {
                    continue;
                }

                toolCalls.Add(new LlmToolCall(
                    rawCall?["id"]?.GetValue<string>() ?? string.Empty,
                    name,
                    ReadArguments(function?["arguments"])));
            }
        }

        return new LlmCompletion(
            content,
            toolCalls,
            string.IsNullOrWhiteSpace(finishReason) ? "stop" : finishReason);
    }

    /// <summary>
    /// Reads tool arguments as raw JSON text.
    /// </summary>
    /// <remarks>
    /// The specification says <c>arguments</c> is a JSON-encoded string, but some
    /// OpenAI-compatible providers emit an object instead. Both are accepted so a provider
    /// quirk does not fail the whole investigation.
    /// </remarks>
    private static string ReadArguments(JsonNode? arguments) => arguments switch
    {
        null => "{}",
        JsonValue value when value.TryGetValue<string>(out var text) => text,
        _ => arguments.ToJsonString(),
    };

    /// <summary>
    /// Translates an unsuccessful provider response into the SQLPulse exception hierarchy.
    /// Python: <c>_translate_provider_error</c>.
    /// </summary>
    /// <remarks>
    /// Status code alone is not enough: providers report an exceeded token-per-minute quota
    /// as 429 and an exceeded context window as 400, both of which are fixed by sending
    /// less rather than by waiting, so the body is inspected as well.
    /// </remarks>
    private static LlmException TranslateError(
        HttpResponseMessage response,
        string payload,
        string provider,
        ILogger logger)
    {
        var status = response.StatusCode;
        var detail = SummarizeError(payload);
        var lower = detail.ToLowerInvariant();

        logger.LogWarning(
            "LLM provider '{Provider}' returned {StatusCode}: {Detail}",
            provider,
            (int)status,
            detail);

        if (status == HttpStatusCode.RequestEntityTooLarge || lower.Contains("request too large"))
        {
            return new LlmPayloadTooLargeException(
                $"The LLM provider rejected the request as too large: {detail}");
        }

        if (status == HttpStatusCode.TooManyRequests)
        {
            // Providers can state the wait twice and disagree: Groq rounds the
            // Retry-After header down to a whole second while its body carries the real
            // figure. Retrying on the shorter of the two just fails again, so both are
            // read and the longer wins.
            var retryAfter = LongerOf(ReadRetryAfter(response), ParseRetryHint(detail));

            // A token-per-minute rejection has two distinct causes needing opposite fixes.
            // If the request cannot be shown to fit inside the quota, it is treated as an
            // oversized payload as before. Only when the provider's own numbers prove the
            // request would fit - meaning the rolling window is merely full - is it a wait
            // problem, where compacting achieves nothing and only a retry can succeed.
            if ((lower.Contains("tokens per minute") || lower.Contains("tpm"))
                && !RequestFitsWithinQuota(detail))
            {
                return new LlmPayloadTooLargeException(
                    $"The LLM provider's token-per-minute limit was exceeded: {detail}");
            }

            return new LlmRateLimitException(
                $"The LLM provider rate limit was exceeded: {detail}",
                retryAfter);
        }

        if (status == HttpStatusCode.BadRequest && lower.Contains("context") && lower.Contains("length"))
        {
            return new LlmPayloadTooLargeException(
                $"The request exceeded the model's context length: {detail}");
        }

        if (status is HttpStatusCode.Unauthorized or HttpStatusCode.Forbidden)
        {
            // Deliberately says nothing about the key itself.
            return new LlmAuthenticationException("The LLM provider rejected the configured credentials.");
        }

        if (status is HttpStatusCode.RequestTimeout or HttpStatusCode.GatewayTimeout)
        {
            return new LlmTimeoutException($"The LLM provider timed out: {detail}");
        }

        if ((int)status >= 500)
        {
            return new LlmUnavailableException(
                $"The LLM provider is unavailable ({(int)status}): {detail}");
        }

        return new LlmInvalidRequestException($"The LLM provider returned {(int)status}: {detail}");
    }

    /// <summary>Extracts a short, credential-free description of a provider error.</summary>
    /// <remarks>
    /// Error bodies can echo part of the request, so the text is sanitized and capped
    /// before it reaches a log or an exception message.
    /// </remarks>
    private static string SummarizeError(string payload)
    {
        var detail = payload;

        try
        {
            if (JsonNode.Parse(payload)?["error"] is { } error)
            {
                detail = error["message"]?.GetValue<string>() ?? error.ToJsonString();
            }
        }
        catch (JsonException)
        {
            // Not JSON — fall back to the raw body.
        }

        detail = LlmSanitizer.SanitizeText(detail).Trim();

        return detail.Length <= MaxErrorDetailChars
            ? detail
            : detail[..MaxErrorDetailChars];
    }

    /// <summary>Reads the provider's <c>Retry-After</c> hint, if it sent one.</summary>
    private static TimeSpan? ReadRetryAfter(HttpResponseMessage response)
    {
        var retryAfter = response.Headers.RetryAfter;
        if (retryAfter is null)
        {
            return null;
        }

        if (retryAfter.Delta is { } delta)
        {
            return delta;
        }

        if (retryAfter.Date is { } date)
        {
            var wait = date - DateTimeOffset.UtcNow;
            return wait > TimeSpan.Zero ? wait : TimeSpan.Zero;
        }

        return null;
    }

    /// <summary>
    /// Matches a provider quota report such as
    /// <c>"Limit 8000, Used 4048, Requested 4067"</c>.
    /// </summary>
    [GeneratedRegex(
        @"limit\s+(?<limit>\d+).*?requested\s+(?<requested>\d+)",
        RegexOptions.IgnoreCase | RegexOptions.Singleline)]
    private static partial Regex TokenQuotaPattern();

    /// <summary>
    /// Matches a provider retry hint such as <c>"Please try again in 862.5ms"</c>
    /// or <c>"try again in 1.5s"</c>.
    /// </summary>
    [GeneratedRegex(
        @"try\s+again\s+in\s+(?<value>\d+(?:\.\d+)?)\s*(?<unit>ms|s)\b",
        RegexOptions.IgnoreCase)]
    private static partial Regex RetryHintPattern();

    /// <summary>
    /// True only when the provider's own numbers prove the request would fit inside the
    /// quota, meaning the rejection came from a momentarily full rolling window rather
    /// than from an oversized request.
    /// </summary>
    /// <remarks>
    /// Returns false when the numbers are absent or unparseable, so an unrecognised quota
    /// message keeps the conservative "send less" handling.
    /// </remarks>
    internal static bool RequestFitsWithinQuota(string detail)
    {
        var match = TokenQuotaPattern().Match(detail);

        return match.Success
            && long.TryParse(match.Groups["limit"].Value, out var limit)
            && long.TryParse(match.Groups["requested"].Value, out var requested)
            && requested <= limit;
    }

    /// <summary>Picks the longer of two optional waits, so neither statement is undercut.</summary>
    internal static TimeSpan? LongerOf(TimeSpan? first, TimeSpan? second) =>
        (first, second) switch
        {
            ({ } a, { } b) => a > b ? a : b,
            ({ } a, null) => a,
            (null, { } b) => b,
            _ => null,
        };

    /// <summary>Reads a retry delay embedded in the provider's error text.</summary>
    /// <remarks>
    /// Groq reports the wait in the message body rather than a <c>Retry-After</c> header,
    /// so the text is the only source of the hint.
    /// </remarks>
    internal static TimeSpan? ParseRetryHint(string detail)
    {
        var match = RetryHintPattern().Match(detail);

        if (!match.Success
            || !double.TryParse(
                match.Groups["value"].Value,
                NumberStyles.Float,
                CultureInfo.InvariantCulture,
                out var value))
        {
            return null;
        }

        var wait = string.Equals(match.Groups["unit"].Value, "ms", StringComparison.OrdinalIgnoreCase)
            ? TimeSpan.FromMilliseconds(value)
            : TimeSpan.FromSeconds(value);

        return wait > TimeSpan.Zero ? wait : null;
    }
}
