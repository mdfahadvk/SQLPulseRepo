<file path="SQLPulseAPI.Net8/Detectors/DetectorBase.cs">
using SQLPulseAPI.Net8.Configuration;
using SQLPulseAPI.Net8.Models.Performance;
using SQLPulseAPI.Net8.Utilities;

namespace SQLPulseAPI.Net8.Detectors;

/// <summary>
/// What a detector produced from one snapshot.
/// </summary>
/// <param name="Findings">Findings raised by the detector.</param>
/// <param name="ExcludedQueries">
/// Queries the detector deliberately skipped, retained so an operator can confirm the
/// filter is not hiding real workload.
/// </param>
public sealed record DetectionResult(
    IReadOnlyList<PerformanceFinding> Findings,
    IReadOnlyList<ExcludedQuery> ExcludedQueries)
{
    /// <summary>An empty result.</summary>
    public static DetectionResult Empty { get; } = new([], []);
}

/// <summary>
/// Base class for the deterministic performance detectors.
/// Ported from <c>BaseDetector</c> in <c>app/detectors/base.py</c>.
/// </summary>
/// <remarks>
/// <para>
/// Detection is deterministic: the same snapshot and thresholds always produce the same
/// findings. No LLM is involved at this layer.
/// </para>
/// <para>
/// Unlike the Python original, exclusions are returned from <see cref="Detect"/> rather
/// than accumulated on the instance. Detectors are registered as singletons and can run
/// for several requests at once, so per-instance mutable state would leak one caller's
/// exclusions into another's response.
/// </para>
/// </remarks>
public abstract class DetectorBase(DetectorThresholdOptions thresholds)
{
    /// <summary>Ordered weakest-first so confidence can be stepped down by index.</summary>
    private static readonly Confidence[] ConfidenceLadder =
    [
        Confidence.Low,
        Confidence.Medium,
        Confidence.High,
    ];

    /// <summary>Thresholds controlling when this detector raises findings.</summary>
    protected DetectorThresholdOptions Thresholds { get; } = thresholds;

    /// <summary>Detector name, used in diagnostics.</summary>
    public abstract string Name { get; }

    /// <summary>Analyses a snapshot. Must be deterministic and must not throw.</summary>
    public abstract DetectionResult Detect(PerformanceSnapshot snapshot);

    /// <summary>Creates a new finding identifier.</summary>
    protected static string NewFindingId() => Guid.NewGuid().ToString();

    /// <summary>Current UTC timestamp, isolated so tests can reason about ordering.</summary>
    protected static DateTimeOffset Now() => DateTimeOffset.UtcNow;

    /// <summary>
    /// Steps <paramref name="confidence"/> down, never below <see cref="Confidence.Low"/>.
    /// </summary>
    protected static Confidence WeakenConfidence(Confidence confidence, int steps = 1)
    {
        var index = Array.IndexOf(ConfidenceLadder, confidence);
        return ConfidenceLadder[Math.Max(0, index - steps)];
    }

    /// <summary>
    /// Returns an <see cref="ExcludedQuery"/> when <paramref name="sqlText"/> is diagnostic
    /// noise, otherwise <see langword="null"/>.
    /// </summary>
    /// <remarks>
    /// Monitoring queries are recorded rather than silently dropped, so an operator can
    /// confirm the filter is not hiding real workload.
    /// </remarks>
    protected static ExcludedQuery? ClassifyMonitoringQuery(
        string? sqlText,
        string? queryHash,
        string? databaseName)
    {
        var reason = QueryFilters.ClassifyExclusion(sqlText);
        if (reason is null)
        {
            return null;
        }

        var preview = Truncate(sqlText, 150);

        return new ExcludedQuery
        {
            Reason = reason,
            QueryHash = queryHash,
            Database = databaseName,
            SqlPreview = string.IsNullOrEmpty(preview) ? null : preview,
        };
    }

    /// <summary>Truncates <paramref name="value"/> to <paramref name="length"/> characters.</summary>
    protected static string Truncate(string? value, int length)
    {
        if (string.IsNullOrEmpty(value))
        {
            return string.Empty;
        }

        return value.Length <= length ? value : value[..length];
    }
}
</file>

<file path="SQLPulseAPI.Net8/Detectors/HighCpuDetector.cs">
using System.Globalization;
using Microsoft.Extensions.Options;
using SQLPulseAPI.Net8.Configuration;
using SQLPulseAPI.Net8.Models.Performance;

namespace SQLPulseAPI.Net8.Detectors;

/// <summary>
/// Detects queries with disproportionately high CPU consumption.
/// Ported from <c>HighCpuDetector</c> in <c>app/detectors/high_cpu.py</c>.
/// </summary>
/// <remarks>
/// Findings here come from the plan cache, which describes lifetime statistics rather
/// than current activity. They are optimization opportunities, never evidence that the
/// server is unhealthy right now — see <c>AnalysisEngine</c>.
/// </remarks>
public sealed class HighCpuDetector(IOptions<DetectorThresholdOptions> thresholds)
    : DetectorBase(thresholds.Value)
{
    /// <inheritdoc />
    public override string Name => "high_cpu_detector";

    /// <inheritdoc />
    public override DetectionResult Detect(PerformanceSnapshot snapshot)
    {
        var section = snapshot.TopCpuQueries;
        if (section is null || !section.Metadata.Success || section.Queries.Count == 0)
        {
            return DetectionResult.Empty;
        }

        var t = Thresholds;
        var now = Now();
        var targetDatabase = snapshot.Database;
        var findings = new List<PerformanceFinding>();
        var excluded = new List<ExcludedQuery>();

        foreach (var query in section.Queries)
        {
            // Database-scope isolation: never report another database's query.
            if (!string.IsNullOrEmpty(targetDatabase)
                && !string.IsNullOrEmpty(query.DatabaseName)
                && !string.Equals(query.DatabaseName, targetDatabase, StringComparison.Ordinal))
            {
                continue;
            }

            // SQLPulse's own DMV reads and other monitoring traffic are not tuning
            // targets — reporting them would crowd out real workload.
            var exclusion = ClassifyMonitoringQuery(query.SqlText, query.QueryHash, query.DatabaseName);
            if (exclusion is not null)
            {
                excluded.Add(exclusion);
                continue;
            }

            // Too few executions to distinguish a real pattern from a one-off.
            if (query.ExecutionCount < t.CpuMinExecutions)
            {
                continue;
            }

            var (severity, confidence, basis) = Classify(query);
            if (severity is null)
            {
                continue;
            }

            // Plan-cache metadata does not always carry a database. Without one the
            // observation is weaker: it cannot be attributed or drilled into.
            var database = query.DatabaseName ?? targetDatabase;
            if (database is null)
            {
                confidence = WeakenConfidence(confidence);
                basis = $"{basis}; database unresolved, confidence reduced";
            }

            var preview = Truncate(query.SqlText, 150);

            findings.Add(new PerformanceFinding
            {
                FindingId = NewFindingId(),
                Category = FindingCategory.HighCpu,
                Server = snapshot.ServerHost,
                Database = database,
                Severity = severity.Value,
                Confidence = confidence,
                FirstObserved = now,
                LastObserved = now,
                Summary =
                    $"High CPU query: avg {Fixed(query.AvgCpuTimeMs, 0)}ms/exec "
                    + $"over {query.ExecutionCount} executions "
                    + $"(total {query.TotalCpuTimeMs}ms)",
                Evidence =
                [
                    $"Query hash: {query.QueryHash ?? "N/A"}",
                    $"Query plan hash: {query.QueryPlanHash ?? "N/A"}",
                    $"Object: {query.ObjectName ?? "N/A"}",
                    $"Execution count: {query.ExecutionCount}",
                    $"Total CPU time: {query.TotalCpuTimeMs}ms",
                    $"Avg CPU time per execution: {Fixed(query.AvgCpuTimeMs, 1)}ms",
                    $"Total elapsed time: {query.TotalElapsedTimeMs}ms",
                    $"Avg elapsed time: {Fixed(query.AvgElapsedTimeMs, 1)}ms",
                    $"Database: {query.DatabaseName ?? "unresolved"}",
                    $"Severity basis: {basis}",
                    $"SQL: {(preview.Length == 0 ? "N/A" : preview)}",
                ],
                Signals = [FindingSignal.HighCpu],
                QueryIdentity = new QueryIdentity
                {
                    QueryHash = query.QueryHash,
                    QueryPlanHash = query.QueryPlanHash,
                    ObjectName = query.ObjectName,
                },
                SeverityBasis = basis,
                LikelyCause =
                    "This query consumes significant CPU per execution based on "
                    + "plan-cache statistics. The specific root cause cannot be "
                    + "determined from aggregate metrics alone.",
                Recommendation =
                    "Retrieve the execution plan via sys.dm_exec_query_plan to "
                    + "identify expensive operators. Review for optimization opportunities.",
                ValidationSteps =
                [
                    "Get the cached execution plan via sys.dm_exec_query_plan",
                    "Identify the most expensive operators in the plan",
                    "Check for missing index suggestions in the plan XML",
                    "Compare actual vs estimated row counts for cardinality issues",
                ],
                HumanReviewRequired = severity == Severity.High,
            });
        }

        return new DetectionResult(findings, excluded);
    }

    /// <summary>
    /// Assigns severity from per-execution cost first, aggregate cost second.
    /// </summary>
    /// <remarks>
    /// Per-execution cost is what identifies an inefficient query. Aggregate totals only
    /// describe how much workload the server ran, so they are treated as the weaker
    /// signal and are gated behind a per-execution floor.
    /// </remarks>
    private (Severity? Severity, Confidence Confidence, string Basis) Classify(TopCpuQuery query)
    {
        var t = Thresholds;

        // Expensive every single time it runs — the strongest plan-cache signal. Still
        // HIGH rather than CRITICAL: cached lifetime statistics cannot show that
        // anything is wrong right now.
        if (query.AvgCpuTimeMs >= t.CpuCriticalAvgMs)
        {
            return (
                Severity.High,
                Confidence.Medium,
                $"avg CPU/exec {Fixed(query.AvgCpuTimeMs, 0)}ms >= "
                    + $"{Fixed(t.CpuCriticalAvgMs, 0)}ms over {query.ExecutionCount} executions");
        }

        if (query.AvgCpuTimeMs >= t.CpuHighAvgMs)
        {
            return (
                Severity.Medium,
                Confidence.Medium,
                $"avg CPU/exec {Fixed(query.AvgCpuTimeMs, 0)}ms >= "
                    + $"{Fixed(t.CpuHighAvgMs, 0)}ms over {query.ExecutionCount} executions");
        }

        // Large lifetime total. Only meaningful if each execution is itself non-trivial,
        // otherwise this is just a frequently-run cheap query.
        if (query.TotalCpuTimeMs >= t.CpuCriticalTotalMs
            && query.AvgCpuTimeMs >= t.CpuMinSignificantAvgMs)
        {
            return (
                Severity.Low,
                Confidence.Low,
                $"total CPU {query.TotalCpuTimeMs}ms >= {t.CpuCriticalTotalMs}ms "
                    + $"with avg {Fixed(query.AvgCpuTimeMs, 0)}ms/exec; aggregate cost only");
        }

        return (null, Confidence.Low, string.Empty);
    }

    private static string Fixed(double value, int decimals) =>
        value.ToString($"F{decimals}", CultureInfo.InvariantCulture);
}
</file>

<file path="SQLPulseAPI.Net8/Detectors/HighIoDetector.cs">
using System.Globalization;
using Microsoft.Extensions.Options;
using SQLPulseAPI.Net8.Configuration;
using SQLPulseAPI.Net8.Models.Performance;

namespace SQLPulseAPI.Net8.Detectors;

/// <summary>
/// Detects queries with excessive logical reads.
/// Ported from <c>HighIoDetector</c> in <c>app/detectors/high_io.py</c>.
/// </summary>
/// <remarks>
/// Like the CPU detector, this reads lifetime plan-cache statistics, so its findings are
/// optimization opportunities rather than evidence of a current incident.
/// </remarks>
public sealed class HighIoDetector(IOptions<DetectorThresholdOptions> thresholds)
    : DetectorBase(thresholds.Value)
{
    /// <inheritdoc />
    public override string Name => "high_io_detector";

    /// <inheritdoc />
    public override DetectionResult Detect(PerformanceSnapshot snapshot)
    {
        var section = snapshot.TopIoQueries;
        if (section is null || !section.Metadata.Success || section.Queries.Count == 0)
        {
            return DetectionResult.Empty;
        }

        var t = Thresholds;
        var now = Now();
        var targetDatabase = snapshot.Database;
        var findings = new List<PerformanceFinding>();
        var excluded = new List<ExcludedQuery>();

        foreach (var query in section.Queries)
        {
            // Database-scope isolation: never report another database's query.
            if (!string.IsNullOrEmpty(targetDatabase)
                && !string.IsNullOrEmpty(query.DatabaseName)
                && !string.Equals(query.DatabaseName, targetDatabase, StringComparison.Ordinal))
            {
                continue;
            }

            // SQLPulse's own DMV reads and other monitoring traffic are not tuning
            // targets — reporting them would crowd out real workload.
            var exclusion = ClassifyMonitoringQuery(query.SqlText, query.QueryHash, query.DatabaseName);
            if (exclusion is not null)
            {
                excluded.Add(exclusion);
                continue;
            }

            // Too few executions to distinguish a real pattern from a one-off.
            if (query.ExecutionCount < t.IoMinExecutions)
            {
                continue;
            }

            var (severity, confidence, basis) = Classify(query);
            if (severity is null)
            {
                continue;
            }

            // Plan-cache metadata does not always carry a database. Without one the
            // observation is weaker: it cannot be attributed or drilled into.
            var database = query.DatabaseName ?? targetDatabase;
            if (database is null)
            {
                confidence = WeakenConfidence(confidence);
                basis = $"{basis}; database unresolved, confidence reduced";
            }

            var preview = Truncate(query.SqlText, 150);

            findings.Add(new PerformanceFinding
            {
                FindingId = NewFindingId(),
                Category = FindingCategory.HighIo,
                Server = snapshot.ServerHost,
                Database = database,
                Severity = severity.Value,
                Confidence = confidence,
                FirstObserved = now,
                LastObserved = now,
                Summary =
                    $"High I/O query: avg {Grouped(query.AvgLogicalReads, 0)} logical reads/exec "
                    + $"over {query.ExecutionCount} executions "
                    + $"(total {Grouped(query.TotalLogicalReads, 0)} reads)",
                Evidence =
                [
                    $"Query hash: {query.QueryHash ?? "N/A"}",
                    $"Query plan hash: {query.QueryPlanHash ?? "N/A"}",
                    $"Object: {query.ObjectName ?? "N/A"}",
                    $"Execution count: {query.ExecutionCount}",
                    $"Total logical reads: {Grouped(query.TotalLogicalReads, 0)}",
                    $"Avg logical reads per execution: {Grouped(query.AvgLogicalReads, 0)}",
                    $"Total physical reads: {Grouped(query.TotalPhysicalReads, 0)}",
                    $"Avg physical reads: {Grouped(query.AvgPhysicalReads, 1)}",
                    $"Database: {query.DatabaseName ?? "unresolved"}",
                    $"Severity basis: {basis}",
                    $"SQL: {(preview.Length == 0 ? "N/A" : preview)}",
                ],
                Signals = [FindingSignal.HighIo],
                QueryIdentity = new QueryIdentity
                {
                    QueryHash = query.QueryHash,
                    QueryPlanHash = query.QueryPlanHash,
                    ObjectName = query.ObjectName,
                },
                SeverityBasis = basis,
                LikelyCause =
                    "This query performs a high number of logical reads per execution "
                    + "based on plan-cache statistics. The specific root cause cannot be "
                    + "determined from aggregate metrics alone.",
                Recommendation =
                    "Retrieve the execution plan via sys.dm_exec_query_plan to "
                    + "identify operators with highest I/O cost. Look for scan operators "
                    + "that could benefit from index changes.",
                ValidationSteps =
                [
                    "Get the execution plan and find operators with highest I/O cost",
                    "Check for Table Scan or Clustered Index Scan operators",
                    "Look for missing index DMV recommendations",
                    "Compare actual vs estimated row counts",
                ],
                HumanReviewRequired = severity == Severity.High,
            });
        }

        return new DetectionResult(findings, excluded);
    }

    /// <summary>
    /// Assigns severity from per-execution reads first, aggregate reads second.
    /// </summary>
    /// <remarks>
    /// Mirrors the CPU detector: reads-per-execution identify an inefficient access path,
    /// whereas lifetime totals mostly reflect how often the query ran. Totals are
    /// therefore gated behind a per-execution floor.
    /// </remarks>
    private (Severity? Severity, Confidence Confidence, string Basis) Classify(TopIoQuery query)
    {
        var t = Thresholds;

        // Extremely read-heavy on every execution. HIGH rather than CRITICAL: cached
        // lifetime statistics cannot demonstrate current resource pressure.
        if (query.AvgLogicalReads >= t.IoCriticalAvgLogicalReads)
        {
            return (
                Severity.High,
                Confidence.Medium,
                $"avg logical reads/exec {Grouped(query.AvgLogicalReads, 0)} >= "
                    + $"{Grouped(t.IoCriticalAvgLogicalReads, 0)} over "
                    + $"{query.ExecutionCount} executions");
        }

        if (query.AvgLogicalReads >= t.IoHighAvgLogicalReads)
        {
            return (
                Severity.Medium,
                Confidence.Medium,
                $"avg logical reads/exec {Grouped(query.AvgLogicalReads, 0)} >= "
                    + $"{Grouped(t.IoHighAvgLogicalReads, 0)} over "
                    + $"{query.ExecutionCount} executions");
        }

        // Large lifetime total. Only meaningful if each execution is itself non-trivial,
        // otherwise this is just a frequently-run cheap query.
        if (query.TotalLogicalReads >= t.IoCriticalTotalLogicalReads
            && query.AvgLogicalReads >= t.IoMinSignificantAvgReads)
        {
            return (
                Severity.Low,
                Confidence.Low,
                $"total logical reads {Grouped(query.TotalLogicalReads, 0)} >= "
                    + $"{Grouped(t.IoCriticalTotalLogicalReads, 0)} with avg "
                    + $"{Grouped(query.AvgLogicalReads, 0)}/exec; aggregate cost only");
        }

        return (null, Confidence.Low, string.Empty);
    }

    /// <summary>Formats with thousands separators, matching Python's <c>:,</c> format.</summary>
    private static string Grouped(double value, int decimals) =>
        value.ToString($"N{decimals}", CultureInfo.InvariantCulture);
}
</file>

<file path="SQLPulseAPI.Net8/Detectors/LongRunningDetector.cs">
using System.Globalization;
using Microsoft.Extensions.Options;
using SQLPulseAPI.Net8.Configuration;
using SQLPulseAPI.Net8.Models.Performance;

namespace SQLPulseAPI.Net8.Detectors;

/// <summary>
/// Detects queries running longer than the configured elapsed-time thresholds.
/// Ported from <c>LongRunningDetector</c> in <c>app/detectors/long_running.py</c>.
/// </summary>
public sealed class LongRunningDetector(IOptions<DetectorThresholdOptions> thresholds)
    : DetectorBase(thresholds.Value)
{
    /// <summary>
    /// SQL Server system/background programs that must not generate findings.
    /// They are always present and are not actionable.
    /// </summary>
    private static readonly HashSet<string> SystemProgramNames = new(StringComparer.Ordinal)
    {
        "sp_server_diagnostics",
        "SQLAgent - TSQL JobStep",
    };

    /// <summary>SQL fragments that identify a system/background task.</summary>
    private static readonly string[] SystemSqlPatterns =
    [
        "sp_server_diagnostics",
        "WAITFOR(RECEIVE",
        "BROKER",
        "xp_sqlagent_notify",
    ];

    /// <summary>Wait types indicating an idle or sleeping system task, not a real query.</summary>
    private static readonly HashSet<string> BackgroundWaitTypes = new(StringComparer.OrdinalIgnoreCase)
    {
        "SP_SERVER_DIAGNOSTICS_SLEEP",
        "WAITFOR",
        "BROKER_RECEIVE_WAITFOR",
        "LAZYWRITER_SLEEP",
        "REQUEST_FOR_DEADLOCK_SEARCH",
        "XE_TIMER_EVENT",
        "SLEEP_TASK",
        "SLEEP_SYSTEMTASK",
    };

    /// <inheritdoc />
    public override string Name => "long_running_detector";

    /// <summary>Returns true when the query is a known system/background task.</summary>
    /// <remarks>
    /// Deliberately narrow: it never excludes a query merely for touching <c>sys.*</c>
    /// objects, because applications read system catalog views legitimately.
    /// </remarks>
    public static bool IsSystemBackgroundQuery(LongRunningQuery query)
    {
        if (query.ProgramName is not null && SystemProgramNames.Contains(query.ProgramName.Trim()))
        {
            return true;
        }

        if (query.WaitType is not null && BackgroundWaitTypes.Contains(query.WaitType))
        {
            return true;
        }

        if (!string.IsNullOrEmpty(query.SqlText))
        {
            foreach (var pattern in SystemSqlPatterns)
            {
                if (query.SqlText.Contains(pattern, StringComparison.OrdinalIgnoreCase))
                {
                    return true;
                }
            }
        }

        return false;
    }

    /// <inheritdoc />
    public override DetectionResult Detect(PerformanceSnapshot snapshot)
    {
        var section = snapshot.LongRunningQueries;
        if (section is null || !section.Metadata.Success || section.Queries.Count == 0)
        {
            return DetectionResult.Empty;
        }

        var queries = section.Queries.Where(query => !IsSystemBackgroundQuery(query)).ToList();
        if (queries.Count == 0)
        {
            return DetectionResult.Empty;
        }

        // Database-scope isolation: a database-scoped analysis must not report another
        // database's activity. Queries with no resolved database are kept, because the
        // snapshot was already collected against the target database.
        var targetDatabase = snapshot.Database;
        if (!string.IsNullOrEmpty(targetDatabase))
        {
            queries = queries
                .Where(query => string.IsNullOrEmpty(query.DatabaseName)
                    || string.Equals(query.DatabaseName, targetDatabase, StringComparison.Ordinal))
                .ToList();

            if (queries.Count == 0)
            {
                return DetectionResult.Empty;
            }
        }

        var t = Thresholds;
        var now = Now();
        var findings = new List<PerformanceFinding>();

        var criticalQueries = queries
            .Where(query => query.ElapsedTimeMs >= t.LongRunningCriticalMs)
            .ToList();

        var highQueries = queries
            .Where(query => query.ElapsedTimeMs >= t.LongRunningHighMs
                && query.ElapsedTimeMs < t.LongRunningCriticalMs)
            .ToList();

        var mediumQueries = queries
            .Where(query => query.ElapsedTimeMs >= t.LongRunningWarningMs
                && query.ElapsedTimeMs < t.LongRunningHighMs)
            .ToList();

        if (criticalQueries.Count >= t.LongRunningCriticalCount)
        {
            // Several queries stuck at once is a different problem from one slow query.
            findings.Add(BuildFinding(
                Severity.Critical,
                Confidence.High,
                criticalQueries,
                snapshot,
                now,
                $"{criticalQueries.Count} queries running longer than "
                    + $"{Seconds(t.LongRunningCriticalMs, 0)}s detected concurrently"));
        }
        else if (criticalQueries.Count > 0)
        {
            // A single critical-duration query is serious but not yet an incident.
            foreach (var query in criticalQueries)
            {
                findings.Add(BuildFinding(
                    Severity.High,
                    Confidence.Medium,
                    [query],
                    snapshot,
                    now,
                    $"Query on session {query.SessionId} running for "
                        + $"{Seconds(query.ElapsedTimeMs, 1)}s "
                        + $"(threshold: {Seconds(t.LongRunningCriticalMs, 0)}s)"));
            }
        }

        foreach (var query in highQueries)
        {
            findings.Add(BuildFinding(
                Severity.Medium,
                Confidence.Medium,
                [query],
                snapshot,
                now,
                $"Query on session {query.SessionId} running for "
                    + $"{Seconds(query.ElapsedTimeMs, 1)}s "
                    + $"(threshold: {Seconds(t.LongRunningHighMs, 0)}s)"));
        }

        // A few mid-tier queries are normal; several at once is worth noting once.
        if (mediumQueries.Count >= 3)
        {
            findings.Add(BuildFinding(
                Severity.Low,
                Confidence.Medium,
                mediumQueries,
                snapshot,
                now,
                $"{mediumQueries.Count} queries running between "
                    + $"{Seconds(t.LongRunningWarningMs, 0)}s and "
                    + $"{Seconds(t.LongRunningHighMs, 0)}s"));
        }

        return new DetectionResult(findings, []);
    }

    private static PerformanceFinding BuildFinding(
        Severity severity,
        Confidence confidence,
        IReadOnlyList<LongRunningQuery> queries,
        PerformanceSnapshot snapshot,
        DateTimeOffset now,
        string summary)
    {
        var evidence = queries.Select(query =>
        {
            var preview = Truncate(query.SqlText, 120);
            return $"Session {query.SessionId}: elapsed={query.ElapsedTimeMs}ms, "
                + $"cpu={query.CpuTimeMs}ms, reads={query.LogicalReads}, "
                + $"db={query.DatabaseName ?? "N/A"}, "
                + $"wait={query.WaitType ?? "none"} — {(preview.Length == 0 ? "N/A" : preview)}";
        }).ToList();

        // The query's own database wins; otherwise fall back to the analysis target.
        // Both may be null, which is reported as null rather than a placeholder.
        var findingDatabase = queries[0].DatabaseName ?? snapshot.Database;

        var waitTypes = queries
            .Select(query => query.WaitType)
            .Where(waitType => !string.IsNullOrEmpty(waitType))
            .Select(waitType => waitType!)
            .Distinct(StringComparer.Ordinal)
            .OrderBy(waitType => waitType, StringComparer.Ordinal)
            .ToList();

        var likelyCause = waitTypes.Count > 0
            ? $"Query is actively waiting on: {string.Join(", ", waitTypes)}. "
                + "The specific root cause requires execution plan analysis."
            : "Query has been executing beyond the expected threshold. "
                + "The specific root cause cannot be determined from elapsed time alone; "
                + "execution plan analysis is the recommended next diagnostic step.";

        return new PerformanceFinding
        {
            FindingId = NewFindingId(),
            Category = FindingCategory.LongRunningQuery,
            Server = snapshot.ServerHost,
            Database = findingDatabase,
            Severity = severity,
            Confidence = confidence,
            FirstObserved = now,
            LastObserved = now,
            Summary = summary,
            Evidence = evidence,
            LikelyCause = likelyCause,
            Recommendation =
                "Retrieve the execution plan for the running session via "
                + "sys.dm_exec_query_plan. Identify the most expensive operator "
                + "and determine whether it is blocked, scanning, or compute-bound.",
            ValidationSteps =
            [
                "Check sys.dm_exec_query_plan for the session's execution plan",
                "Examine the current wait type and resource to understand the bottleneck",
                "Check if the query is waiting on locks, I/O, or other resources",
                "Compare actual vs estimated rows in the plan to detect cardinality issues",
            ],
            HumanReviewRequired = severity is Severity.Critical or Severity.High,
        };
    }

    private static string Seconds(long milliseconds, int decimals) =>
        (milliseconds / 1000.0).ToString($"F{decimals}", CultureInfo.InvariantCulture);
}
</file>

<file path="SQLPulseAPI.Net8/Detectors/QueryRegressionDetector.cs">
using System.Globalization;
using Microsoft.Extensions.Options;
using SQLPulseAPI.Net8.Configuration;
using SQLPulseAPI.Net8.Models.History;
using SQLPulseAPI.Net8.Models.Performance;
using SQLPulseAPI.Net8.Services.History;

namespace SQLPulseAPI.Net8.Detectors;

/// <summary>
/// Detects queries whose current metrics significantly exceed their historical baseline.
/// Ported from <c>QueryRegressionDetector</c> in <c>app/detectors/regression.py</c>.
/// </summary>
/// <remarks>
/// <para>
/// This detector does not derive from <see cref="DetectorBase"/> because it must read
/// stored history, which is asynchronous. Forcing it into the synchronous
/// <see cref="DetectorBase.Detect"/> signature would mean blocking on I/O inside a
/// request thread, so it exposes <see cref="DetectAsync"/> and is invoked separately.
/// </para>
/// <para>
/// Every comparison is arithmetic against stored samples. No LLM is involved: a
/// regression claim is evidence and must be reproducible.
/// </para>
/// </remarks>
public sealed class QueryRegressionDetector(
    IBaselineService baselineService,
    IOptions<DetectorThresholdOptions> thresholds)
{
    private readonly DetectorThresholdOptions _thresholds = thresholds.Value;

    /// <summary>Detector name, used in diagnostics.</summary>
    public string Name => "query_regression_detector";

    /// <summary>
    /// Current metrics for one query, assembled from the CPU and I/O sections.
    /// </summary>
    private sealed class CurrentMetrics
    {
        public string Database { get; init; } = string.Empty;
        public double AvgCpuMs { get; set; }
        public double AvgElapsedMs { get; set; }
        public double AvgLogicalReads { get; set; }
        public string? SqlText { get; init; }
    }

    /// <summary>
    /// Compares each query in the snapshot against its baseline and raises findings for
    /// significant degradation.
    /// </summary>
    public async Task<DetectionResult> DetectAsync(
        PerformanceSnapshot snapshot,
        CancellationToken cancellationToken = default)
    {
        var targetDatabase = snapshot.Database;
        var currentQueries = CollectCurrentMetrics(snapshot, targetDatabase);
        if (currentQueries.Count == 0)
        {
            return DetectionResult.Empty;
        }

        var t = _thresholds;
        var now = DateTimeOffset.UtcNow;
        var window = t.RegressionBaselineWindow;
        var minSamples = t.RegressionMinSamples;
        var findings = new List<PerformanceFinding>();

        foreach (var (queryHash, metrics) in currentQueries)
        {
            var database = metrics.Database;

            // Returns null unless the baseline is READY, so an under-sampled baseline can
            // never be compared against.
            var baseline = await baselineService.GetForRegressionAsync(
                queryHash,
                database,
                window,
                minSamples,
                cancellationToken);

            if (baseline is null)
            {
                continue;
            }

            var regression = CheckRegression(metrics, baseline);
            if (regression is null)
            {
                continue;
            }

            var (dimension, multiplier, currentValue, baselineMean, sampleCount, stdDev) = regression.Value;

            Severity severity;
            if (multiplier >= t.RegressionCriticalMultiplier)
            {
                severity = Severity.Critical;
            }
            else if (multiplier >= t.RegressionHighMultiplier)
            {
                severity = Severity.High;
            }
            else if (multiplier >= t.RegressionWarningMultiplier)
            {
                severity = Severity.Medium;
            }
            else
            {
                continue;
            }

            var confidence = ComputeConfidence(sampleCount, stdDev, baselineMean);
            var preview = Truncate(metrics.SqlText, 120);

            var evidence = new List<string>
            {
                $"Query hash: {queryHash}",
                $"Database: {database}",
                $"Regression dimension: {dimension}",
                $"Current value: {Fixed(currentValue, 1)}",
                $"Baseline mean ({window}): {Fixed(baselineMean, 1)}",
                $"Regression multiplier: {Fixed(multiplier, 1)}x",
                $"Baseline samples: {sampleCount}",
                $"Baseline std dev: {Fixed(stdDev, 1)}",
            };

            if (preview.Length > 0)
            {
                evidence.Add($"SQL: {preview}");
            }

            findings.Add(new PerformanceFinding
            {
                FindingId = Guid.NewGuid().ToString(),
                Category = FindingCategory.QueryRegression,
                Server = snapshot.ServerHost,
                Database = database,
                Severity = severity,
                Confidence = confidence,
                FirstObserved = now,
                LastObserved = now,
                Summary = $"Query {dimension} is {Fixed(multiplier, 1)}x worse than its {window} baseline.",
                Evidence = evidence,
                LikelyCause =
                    $"Query performance has regressed: current {dimension} "
                    + $"({Fixed(currentValue, 0)}) significantly exceeds the historical "
                    + $"baseline ({Fixed(baselineMean, 0)}). This indicates a recent "
                    + "change in query behavior.",
                Recommendation =
                    "Compare the current execution plan against a known-good plan. "
                    + "Check for recent schema changes, statistics updates, parameter "
                    + "changes, or data volume growth that could explain the regression.",
                ValidationSteps =
                [
                    "Retrieve the current execution plan",
                    "Check if statistics were recently updated",
                    "Look for recent schema or index changes",
                    "Verify data volume hasn't changed dramatically",
                ],
                QueryIdentity = new QueryIdentity { QueryHash = queryHash },
                HumanReviewRequired = severity is Severity.Critical or Severity.High,
            });
        }

        return new DetectionResult(findings, []);
    }

    /// <summary>
    /// Builds the current per-query metrics from the CPU section first, then merges the
    /// I/O section into it.
    /// </summary>
    private static Dictionary<string, CurrentMetrics> CollectCurrentMetrics(
        PerformanceSnapshot snapshot,
        string? targetDatabase)
    {
        var current = new Dictionary<string, CurrentMetrics>(StringComparer.Ordinal);

        var cpuSection = snapshot.TopCpuQueries;
        if (cpuSection is not null && cpuSection.Metadata.Success)
        {
            foreach (var query in cpuSection.Queries)
            {
                if (string.IsNullOrEmpty(query.QueryHash) || !InScope(query.DatabaseName, targetDatabase))
                {
                    continue;
                }

                current[query.QueryHash] = new CurrentMetrics
                {
                    Database = HistoryService.ResolveDatabase(query.DatabaseName, targetDatabase),
                    AvgCpuMs = query.AvgCpuTimeMs,
                    AvgElapsedMs = query.AvgElapsedTimeMs,
                    AvgLogicalReads = query.AvgLogicalReads,
                    SqlText = query.SqlText,
                };
            }
        }

        var ioSection = snapshot.TopIoQueries;
        if (ioSection is not null && ioSection.Metadata.Success)
        {
            foreach (var query in ioSection.Queries)
            {
                if (string.IsNullOrEmpty(query.QueryHash) || !InScope(query.DatabaseName, targetDatabase))
                {
                    continue;
                }

                if (current.TryGetValue(query.QueryHash, out var existing))
                {
                    // The I/O collector orders by reads, so a larger figure there is the
                    // more complete measurement for the same query.
                    if (query.AvgLogicalReads > existing.AvgLogicalReads)
                    {
                        existing.AvgLogicalReads = query.AvgLogicalReads;
                    }

                    continue;
                }

                // I/O-only query: CPU and elapsed are unmeasured here and stay at zero,
                // which excludes them from comparison rather than inventing a value.
                current[query.QueryHash] = new CurrentMetrics
                {
                    Database = HistoryService.ResolveDatabase(query.DatabaseName, targetDatabase),
                    AvgLogicalReads = query.AvgLogicalReads,
                    SqlText = query.SqlText,
                };
            }
        }

        return current;
    }

    /// <summary>Database-scope isolation: never report another database's query.</summary>
    private static bool InScope(string? queryDatabase, string? targetDatabase) =>
        string.IsNullOrEmpty(targetDatabase)
        || string.IsNullOrEmpty(queryDatabase)
        || string.Equals(queryDatabase, targetDatabase, StringComparison.Ordinal);

    /// <summary>
    /// Returns the worst regression across the compared dimensions, or
    /// <see langword="null"/> when none reaches the warning multiplier.
    /// </summary>
    /// <remarks>
    /// A dimension is skipped when its baseline statistic is missing, its baseline mean
    /// is not positive, or the current value is not positive. Dividing by a zero or
    /// absent baseline would manufacture an unbounded multiplier out of no evidence.
    /// </remarks>
    private (string Dimension, double Multiplier, double CurrentValue, double BaselineMean, int SampleCount, double StdDev)?
        CheckRegression(CurrentMetrics metrics, QueryBaseline baseline)
    {
        (string Dimension, double Current, BaselineStatistic? Stat)[] checks =
        [
            ("avg_elapsed_ms", metrics.AvgElapsedMs, baseline.AvgElapsedMs),
            ("avg_cpu_ms", metrics.AvgCpuMs, baseline.AvgCpuMs),
            ("avg_logical_reads", metrics.AvgLogicalReads, baseline.AvgLogicalReads),
        ];

        (string, double, double, double, int, double)? worst = null;

        foreach (var (dimension, currentValue, stat) in checks)
        {
            if (stat is null || stat.Mean <= 0 || currentValue <= 0)
            {
                continue;
            }

            var multiplier = currentValue / stat.Mean;
            if (multiplier < _thresholds.RegressionWarningMultiplier)
            {
                continue;
            }

            if (worst is null || multiplier > worst.Value.Item2)
            {
                worst = (dimension, multiplier, currentValue, stat.Mean, stat.SampleCount, stat.StandardDeviation);
            }
        }

        return worst;
    }

    /// <summary>
    /// Derives confidence from how much history exists and how stable it is.
    /// </summary>
    /// <remarks>
    /// A baseline that swings wildly cannot support a strong claim even when the
    /// multiplier is large, so relative variance caps confidence independently of
    /// severity.
    /// </remarks>
    internal static Confidence ComputeConfidence(int sampleCount, double stdDev, double baselineMean)
    {
        if (sampleCount < 5)
        {
            return Confidence.Low;
        }

        var cv = baselineMean > 0 ? stdDev / baselineMean : 0.0;

        if (sampleCount >= 10 && cv < 0.5)
        {
            return Confidence.High;
        }

        return cv < 1.0 ? Confidence.Medium : Confidence.Low;
    }

    private static string Truncate(string? value, int length)
    {
        if (string.IsNullOrEmpty(value))
        {
            return string.Empty;
        }

        return value.Length <= length ? value : value[..length];
    }

    private static string Fixed(double value, int decimals) =>
        value.ToString($"F{decimals}", CultureInfo.InvariantCulture);
}
