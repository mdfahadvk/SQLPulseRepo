    logical_reads: int = 0
    writes: int = 0
    wait_type: str | None = None
    wait_time_ms: int = 0
    status: str = ""
    login_name: str | None = None
    host_name: str | None = None
    program_name: str | None = None


class LongRunningQueriesResult(BaseModel):
