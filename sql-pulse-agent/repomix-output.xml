    session_id: int
    blocking_session_id: int | None = None
    wait_type: str | None = None
    wait_time_ms: int = 0
    wait_resource: str | None = None
    database_name: str | None = None
    sql_text: str | None = None
    status: str = ""
    login_name: str | None = None
    host_name: str | None = None
