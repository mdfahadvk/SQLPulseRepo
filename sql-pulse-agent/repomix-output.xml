    median: float = 0.0
    minimum: float = 0.0
    maximum: float = 0.0
    standard_deviation: float = 0.0
    p50: float = 0.0
    p95: float = 0.0


class QueryBaseline(BaseModel):
    """Computed baseline for a query over a time window."""

    query_hash: str
