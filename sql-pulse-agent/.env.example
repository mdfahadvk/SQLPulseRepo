# SQLPulse Environment Configuration
# Copy this file to .env and fill in your values.

# SQL Server Connection
SQL_SERVER=MSI-STGERPDBL
SQL_USERNAME=sqlweb
SQL_PASSWORD=your-password-here
SQL_DRIVER={ODBC Driver 18 for SQL Server}
SQL_ENCRYPT=yes
SQL_TRUST_SERVER_CERTIFICATE=yes
SQL_DEFAULT_DATABASE=master
SQL_CONNECTION_TIMEOUT=30
SQL_QUERY_TIMEOUT=60

# Application
DEBUG=false
LOG_LEVEL=INFO

# Slow-query monitoring vs application timeout
#
# These answer different questions and are never derived from each other:
#   SLOW_QUERY_THRESHOLD_MS  "which queries are worth looking at?"
#   APPLICATION_TIMEOUT_MS   "at what duration does the client give up?"
#
# A query over SLOW_QUERY_THRESHOLD_MS is a SLOW_QUERY_CANDIDATE.  It is only
# a TIMEOUT_CANDIDATE if it also reaches APPLICATION_TIMEOUT_MS.  Leave
# APPLICATION_TIMEOUT_MS unset unless you know your application's real command
# timeout — SQLPulse then reports timeout status as unavailable instead of
# guessing, which is the honest answer.
# SLOW_QUERY_THRESHOLD_MS=5000
# APPLICATION_TIMEOUT_MS=30000

# Workload classification (optional, comma-separated, case-insensitive
# substring match against the session's program_name/application_name).
# Query Store does not record program_name, so most historical candidates
# classify as UNKNOWN — that is correct, not a defect. These mappings let you
# resolve the programs you know about.
# WORKLOAD_APPLICATION_PROGRAMS=MerchPortal,OrderService
# WORKLOAD_BACKGROUND_PROGRAMS=NightlyEtlRunner,ReportScheduler

# Detector Thresholds (optional — uncomment to override defaults)
# DETECTOR_LONG_RUNNING_WARNING_MS=10000
# DETECTOR_LONG_RUNNING_HIGH_MS=30000
# DETECTOR_LONG_RUNNING_CRITICAL_MS=120000
# DETECTOR_BLOCKING_WARNING_WAIT_MS=5000
# DETECTOR_BLOCKING_HIGH_WAIT_MS=30000
# DETECTOR_BLOCKING_CRITICAL_WAIT_MS=60000

# AI Agent (optional — uncomment to enable)
# LLM_API_KEY=sk-your-openai-api-key
# LLM_PROVIDER accepts: openai, azure_openai, groq
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o
# LLM_BASE_URL=
#
# Any OpenAI-compatible endpoint works without code changes: keep
# LLM_PROVIDER=openai and point LLM_BASE_URL at the vendor. Setting
# LLM_PROVIDER to an unlisted name is rejected. Examples:
#   Ollama (local)  LLM_BASE_URL=http://localhost:11434/v1
#   Gemini          LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   OpenRouter      LLM_BASE_URL=https://openrouter.ai/api/v1
#
# LLM_TEMPERATURE=0.1
# Tokens the model may generate per call. Providers count this against
# tokens-per-minute quotas, so lower it on free/low-tier plans.
# LLM_MAX_TOKENS=1500
# Maximum characters of a single tool result forwarded to the model.
# Lower it if the provider reports "request too large".
# MAX_TOOL_RESULT_CHARS=4000
# On a low tokens-per-minute quota (e.g. Groq's free tier is 8000 TPM),
# also reduce MAX_AGENT_TOOL_CALLS so one investigation stays in budget.
# MAX_AGENT_TOOL_CALLS=10
# MAX_AGENT_EXECUTION_SECONDS=60

