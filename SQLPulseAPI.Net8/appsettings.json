{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",
  "Application": {
    "Name": "SQLPulse",
    "Version": "0.1.0",
    "Debug": false
  },
  "SqlServer": {
    "Server": "",
    "Username": "",
    "Password": "",
    "DefaultDatabase": "master",
    "Encrypt": true,
    "TrustServerCertificate": true,
    "ConnectionTimeoutSeconds": 30,
    "CommandTimeoutSeconds": 60,
    "ApplicationName": "SQLPulse"
  },
  "Analysis": {
    "SlowQueryThresholdMs": 5000,
    "ApplicationTimeoutMs": null,
    "WorkloadApplicationPrograms": "",
    "WorkloadBackgroundPrograms": ""
  },
  "History": {
    "RetentionDays": 30,
    "BaselineMinSamples": 5,
    "DatabasePath": "sqlpulse_history.db"
  },
  "SqlErrors": {
    "CorrelationWindowMinutes": 5,
    "DefaultLookbackHours": 24,
    "EventCacheSize": 2000,
    "EnableQueryStoreTimeoutCandidates": true,
    "EnableSqlServerErrorSource": true,
    "SigNozEnabled": false,
    "SigNozBaseUrl": "",
    "SigNozApiKey": "",
    "SigNozServiceName": "",
    "SigNozTimeoutSeconds": 15,
    "SigNoz": {
      "Enabled": true,
      "BaseUrl": "https://eyss-c9b9.us.signoz.cloud",
      "HeaderKey": "SIGNOZ-API-KEY",
      "HeaderValue": "6801263e-5d19-40ee-9348-837c17cb3a0b",
      "ServiceName": "VendorMaintenanceAPI",
      "TimeoutSeconds": 15,
      "AuthHeader": "SIGNOZ-API-KEY",
      "Signal": "logs",
      "Applications": [
        {
          "Name": "VendorMaintenanceAPI",
          "ServiceName": "VendorMaintenanceAPI",
          "Databases": ["NS_APP", "NSWeb"],
          "Environment": ["STGERP"],
          "TelemetryEnabled": true
        }
      ]
    },
    "CaptureParameterValues": false,
    "ExtendedEventsSessionName": "system_health"
  },
  "Llm": {
    "Provider": "groq",
    //  "ApiKey": "",
    "ApiKey": "",
    "Model": "openai/gpt-oss-120b",
    "BaseUrl": "",
    "Temperature": 0.1,
    "RequestTimeoutSeconds": 60,
    "MaxTokens": 1300,
    "RateLimitCooldownSeconds": 30
  },
  "Agent": {
    "MaxToolResultChars": 1500,
    "MaxToolCalls": 2,
    "MaxExecutionSeconds": 120
  }
}
